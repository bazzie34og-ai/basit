# Copy to .env for local dev (netlify dev). Set the real values in
# Netlify → Site configuration → Environment variables. Never commit secrets.

# --- Site ---
# Preview builds: noindex, robots Disallow: /, and the preview ribbon. Set to false at go-live.
PREVIEW_MODE=true
# The live domain at go-live, e.g. https://www.smithandshine.co.uk (no trailing slash)
SITE_URL=https://smith-and-shine-telford.netlify.app

# --- Booking emails (Resend: https://resend.com) ---
RESEND_API_KEY=
# Preview: Primo Partners. Go-live: the owner's email (TODO-CONFIRM). Comma-separate for several.
BOOKING_TO_EMAIL=itsprimopartners@gmail.com
# Use onboarding@resend.dev until the business domain is verified in Resend.
# NOTE: with onboarding@resend.dev Resend only delivers to the Resend account owner's
# own address, so customer auto-replies start working once the domain is verified.
BOOKING_FROM_EMAIL=onboarding@resend.dev

# Optional: one-line alert per booking (Slack/Discord/Make/Zapier incoming webhook)
NOTIFY_WEBHOOK_URL=

# --- /api/bookings.csv export (Basic Auth) ---
ADMIN_USER=
ADMIN_PASS=

# Optional extra salt for hashing IPs in the rate limiter
RATE_SALT=

# --- Optional Cloudflare Turnstile (spam check) ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Optional Google Analytics 4 (loads only after the visitor says yes) ---
PUBLIC_GA4_ID=
