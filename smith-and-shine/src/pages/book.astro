---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import {
  sizes, activeServices, howHeardOptions, phone, telHref, whatsappHref, business, googleRating, formatGBP,
} from '../config/site.ts';
import { LIMITS } from '../lib/booking.ts';
import { TURNSTILE_SITE_KEY } from '../config/env.ts';
import type { Crumb } from '../lib/schema.ts';

const crumbs: Crumb[] = [{ name: 'Home', url: '/' }, { name: 'Book', url: '/book/' }];
const waText = 'Hi Chris, I’d like to book a valet. My car is a … and my postcode is …';
const groups = [
  { label: 'Monthly', ids: ['monthly'] },
  { label: 'Cars', ids: ['mini-valet', 'full-valet', 'full-valet-deep', 'detailing', 'paint-correction'] },
  { label: 'Motorbikes', ids: ['moto-clean', 'moto-detail'] },
  { label: 'Vans', ids: ['van-mini'] },
  { label: 'On quote', ids: ['ceramic', 'ppf', 'not-sure'] },
];
const priceLabel = (id: string) => {
  const s = activeServices.find((x) => x.id === id)!;
  if (s.id === 'monthly') return 'from £30 a visit';
  return s.from === null ? 'quote' : `from ${formatGBP(s.from)}`;
};
const builtAt = Date.now();
---
<Base
  title="Book a Car Valet in Telford | Smith & Shine"
  description="Book a car valet in Telford in 3 quick steps, with a live price as you go. Or WhatsApp or call Chris. We come to your driveway, home or work."
  waText={waText}
  crumbs={crumbs}
>
  {TURNSTILE_SITE_KEY && <script is:inline slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <section class="iron bhero">
    <div class="wrap">
      <Breadcrumbs crumbs={crumbs} />
      <div class="bh-grid">
        <div>
          <h1>Book Your Valet</h1>
          <p class="lead">Three short steps. You’ll see a price as you go, and Chris will confirm the day and the final price with you. The price we quote is the price you pay.</p>
        </div>
        <div class="quick">
          <p class="label label-gold">Prefer to chat?</p>
          <a class="btn btn-primary" href={whatsappHref(waText)} data-track="whatsapp_click"><Icon name="whatsapp" /> WhatsApp Chris</a>
          <a class="btn btn-ghost" href={telHref} data-track="call_click"><Icon name="phone" /> Call {phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="ivory book-sec">
    <div class="wrap book-grid">
      <form
        id="book-form"
        class="bform"
        action="/api/book"
        method="post"
        enctype="multipart/form-data"
        novalidate
        data-max-photos={LIMITS.photos}
      >
        <ol class="progress" aria-hidden="true">
          <li class="is-current" data-p="1"><span>1</span> Your car</li>
          <li data-p="2"><span>2</span> Where &amp; when</li>
          <li data-p="3"><span>3</span> Your details</li>
        </ol>

        <div class="form-error" role="alert" hidden id="form-error"></div>

        <!-- STEP 1 -->
        <fieldset class="step" data-step="1">
          <legend><span class="sn">Step 1 of 3</span> Your car</legend>

          <div class="field">
            <label for="vehicle">Make and model <span class="req">required</span></label>
            <input id="vehicle" name="vehicle" type="text" required maxlength={LIMITS.vehicle} autocomplete="off" placeholder="e.g. Ford Focus, VW Golf, Tesla Model 3" aria-describedby="vehicle-err" />
            <p class="err" id="vehicle-err"></p>
          </div>

          <div class="field" role="radiogroup" aria-labelledby="size-lbl" aria-describedby="size-err">
            <p class="flabel" id="size-lbl">Vehicle size <span class="req">required</span></p>
            <div class="sizes">
              {sizes.map((s) => (
                <label class="size">
                  <input type="radio" name="size" value={s.id} required />
                  <span class="sz-name">{s.label}</span>
                  <span class="sz-hint">{s.hint}</span>
                </label>
              ))}
            </div>
            <p class="err" id="size-err"></p>
          </div>

          <div class="field">
            <label for="service">Service <span class="req">required</span></label>
            <select id="service" name="service" required aria-describedby="service-err service-help">
              <option value="">Choose a service…</option>
              {groups.map((g) => (
                <optgroup label={g.label}>
                  {g.ids.filter((id) => activeServices.some((s) => s.id === id)).map((id) => {
                    const s = activeServices.find((x) => x.id === id)!;
                    return <option value={id} data-sizes={s.forSizes.join(',')}>{s.formLabel} ({priceLabel(id)})</option>;
                  })}
                </optgroup>
              ))}
            </select>
            <p class="help" id="service-help">Not sure? Pick “Not sure: help me choose” and Chris will suggest one.</p>
            <p class="err" id="service-err"></p>
          </div>

          <div class="nav-row">
            <button type="button" class="btn btn-ink js-only" data-next>Next: where &amp; when <Icon name="arrow" /></button>
          </div>
        </fieldset>

        <!-- STEP 2 -->
        <fieldset class="step" data-step="2">
          <legend><span class="sn">Step 2 of 3</span> Where &amp; when</legend>

          <div class="field">
            <label for="postcode">Postcode where the car will be <span class="req">required</span></label>
            <input id="postcode" name="postcode" type="text" required maxlength={LIMITS.postcode} autocomplete="postal-code" inputmode="text" autocapitalize="characters" placeholder="e.g. TF1 1AA" aria-describedby="postcode-err postcode-help" />
            <p class="help" id="postcode-help">So we know how far we’re coming. We never publish it.</p>
            <p class="err" id="postcode-err"></p>
          </div>

          <div class="field">
            <label for="preferredDay">Preferred day or time <span class="opt">optional</span></label>
            <input id="preferredDay" name="preferredDay" type="text" maxlength={LIMITS.preferredDay} placeholder="e.g. Saturday morning, or any day next week" />
          </div>

          <div class="field">
            <label for="notes">Anything we should know? <span class="opt">optional</span></label>
            <textarea id="notes" name="notes" rows="4" maxlength={LIMITS.notes} placeholder="Dog hair, a stain on the back seat, the car’s at work, parking is tight…"></textarea>
          </div>

          <div class="field">
            <label for="photos">Photos of the car <span class="opt">optional, up to {LIMITS.photos}</span></label>
            <input id="photos" name="photos" type="file" accept="image/*" multiple aria-describedby="photos-help photos-err" />
            <p class="help" id="photos-help"><Icon name="camera" class="ci" /> Really helpful for paint correction, ceramic and PPF quotes.</p>
            <ul class="thumbs" id="thumbs" role="list"></ul>
            <p class="err" id="photos-err"></p>
          </div>

          <div class="nav-row">
            <button type="button" class="btn btn-outline-ink js-only" data-back>Back</button>
            <button type="button" class="btn btn-ink js-only" data-next>Next: your details <Icon name="arrow" /></button>
          </div>
        </fieldset>

        <!-- STEP 3 -->
        <fieldset class="step" data-step="3">
          <legend><span class="sn">Step 3 of 3</span> Your details</legend>

          <div class="two">
            <div class="field">
              <label for="name">Your name <span class="req">required</span></label>
              <input id="name" name="name" type="text" required maxlength={LIMITS.name} autocomplete="name" aria-describedby="name-err" />
              <p class="err" id="name-err"></p>
            </div>
            <div class="field">
              <label for="phone">Mobile number <span class="req">required</span></label>
              <input id="phone" name="phone" type="tel" required maxlength={LIMITS.phone} autocomplete="tel" inputmode="tel" placeholder="07…" aria-describedby="phone-err" />
              <p class="err" id="phone-err"></p>
            </div>
          </div>
          <div class="two">
            <div class="field">
              <label for="email">Email <span class="opt">optional, for a confirmation</span></label>
              <input id="email" name="email" type="email" maxlength={LIMITS.email} autocomplete="email" aria-describedby="email-err" />
              <p class="err" id="email-err"></p>
            </div>
            <div class="field">
              <label for="howHeard">How did you find us? <span class="opt">optional</span></label>
              <select id="howHeard" name="howHeard">
                <option value="">Choose…</option>
                {howHeardOptions.map((o) => <option>{o}</option>)}
              </select>
            </div>
          </div>

          <!-- spam traps: humans never see or fill these -->
          <div class="hp" aria-hidden="true">
            <label for="company">Company (leave blank)</label>
            <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="ts" value={builtAt} />
          <input type="hidden" name="estimate" value="" />
          <input type="hidden" name="pageUrl" value="/book/" />
          <input type="hidden" name="utm_source" value="" />
          <input type="hidden" name="utm_medium" value="" />
          <input type="hidden" name="utm_campaign" value="" />
          <input type="hidden" name="utm_term" value="" />
          <input type="hidden" name="utm_content" value="" />
          <input type="hidden" name="gclid" value="" />
          <input type="hidden" name="landing" value="" />
          <input type="hidden" name="referrer" value="" />

          {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>}

          <p class="privacy">We only use your details to sort out your booking. <a href="/privacy/">Privacy</a>.</p>

          <div class="nav-row final">
            <button type="button" class="btn btn-outline-ink js-only" data-back>Back</button>
            <button type="submit" class="btn btn-primary submit" data-submit>Send booking request</button>
          </div>
          <div class="wa-alt js-only">
            <p>Rather send it on WhatsApp?</p>
            <a class="btn btn-ghost-ink" data-wa-summary href={whatsappHref(waText)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Send on WhatsApp instead</a>
          </div>
        </fieldset>
      </form>

      <aside class="estimate plate" aria-live="polite">
        <span class="rivets" aria-hidden="true"></span>
        <p class="label label-gold">Your estimate</p>
        <p class="est-amt" id="est-amt">Pick a size and service</p>
        <p class="est-note" id="est-note">Prices come straight from our price list. Chris confirms the final price before he starts.</p>
        <hr class="rule-gold" />
        <ul class="est-sum" id="est-sum" role="list"></ul>
        <p class="est-small">{business.replyPromise} <br />{googleRating.summary}</p>
      </aside>
    </div>
  </section>
</Base>

<script>
  import '../scripts/book.ts';
</script>

<style>
  .bhero { padding: 0.5rem 0 var(--s-4); }
  .bh-grid { display: grid; gap: 1.5rem 4rem; align-items: end; margin-top: 0.75rem; }
  @media (min-width: 900px) { .bh-grid { grid-template-columns: 1.3fr 0.7fr; } }
  h1 { font-size: var(--step-5); margin-bottom: 0.75rem; }
  .lead { color: #e7e1d4; max-width: 46ch; font-size: var(--step-1); }
  .quick { display: grid; gap: 0.6rem; }
  .book-sec { padding: var(--s-4) 0 var(--s-6); }
  .book-grid { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 980px) { .book-grid { grid-template-columns: minmax(0, 1fr) 20rem; gap: 4rem; } .estimate { position: sticky; top: 6rem; } }

  .progress { display: none; list-style: none; padding: 0; margin: 0 0 1.5rem; gap: 0.5rem; }
  :global(.js) .progress { display: grid; grid-template-columns: repeat(3, 1fr); }
  .progress li { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.04em; color: var(--ink-soft); padding-top: 0.6rem; border-top: 3px solid #d9cfbb; }
  .progress li span { display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; border: 1.5px solid currentColor; margin-right: 0.3rem; font-size: 0.75rem; }
  .progress li.is-current, .progress li.is-done { color: var(--ink); border-top-color: var(--gold-ink); }
  .progress li.is-done span { background: var(--gold-ink); border-color: var(--gold-ink); color: var(--ivory); }

  .step { border: 0; padding: 0; margin: 0 0 2.5rem; min-width: 0; }
  :global(.js) .step:not(.is-active) { display: none; }
  legend { font-family: var(--font-display); font-size: var(--step-3); font-weight: 650; margin-bottom: 1.25rem; padding: 0; }
  .sn { display: block; font-family: var(--font-body); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold-ink-strong); margin-bottom: 0.25rem; }
  .field { margin-bottom: 1.4rem; }
  label, .flabel { display: block; font-weight: 700; margin-bottom: 0.4rem; }
  .req, .opt { font-weight: 500; font-size: 0.8125rem; color: var(--ink-soft); margin-left: 0.35rem; }
  input[type='text'], input[type='tel'], input[type='email'], select, textarea {
    width: 100%; min-height: 52px; padding: 0.75rem 0.9rem; background: #fff; border: 1.5px solid #b9ad95;
    border-radius: var(--radius); font-size: 1.0625rem; color: var(--ink);
  }
  textarea { min-height: 7rem; resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: 3px solid var(--gold); outline-offset: 1px; border-color: var(--ink); }
  [aria-invalid='true'] { border-color: var(--oxide) !important; background: #fdf5f2 !important; }
  .err { color: var(--oxide); font-weight: 700; font-size: 0.9375rem; margin-top: 0.35rem; }
  .err:empty { display: none; }
  .help { font-size: 0.875rem; color: var(--ink-soft); margin-top: 0.35rem; display: flex; gap: 0.35rem; align-items: center; }
  .help :global(.ci) { width: 1rem; height: 1rem; flex: none; }
  .sizes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
  @media (min-width: 640px) { .sizes { grid-template-columns: repeat(3, 1fr); } }
  .size { position: relative; display: grid; gap: 0.15rem; padding: 0.85rem 0.9rem; border: 1.5px solid #b9ad95; border-radius: var(--radius); background: #fff; cursor: pointer; margin: 0; min-height: 44px; }
  .size input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .sz-name { font-family: var(--font-display); font-size: 1.15rem; font-weight: 650; }
  .sz-hint { font-size: 0.8125rem; color: var(--ink-soft); font-weight: 500; line-height: 1.35; }
  .size:has(input:checked) { border-color: var(--ink); background: var(--iron); color: var(--ivory); box-shadow: inset 0 0 0 1px var(--gold); }
  .size:has(input:checked) .sz-hint { color: var(--steel-light); }
  .size:has(input:focus-visible) { outline: 3px solid var(--gold); outline-offset: 2px; }
  .two { display: grid; gap: 0 1.25rem; }
  @media (min-width: 640px) { .two { grid-template-columns: 1fr 1fr; } }
  .nav-row { display: flex; gap: 0.75rem; justify-content: space-between; margin-top: 0.5rem; flex-wrap: wrap; }
  .nav-row .btn :global(svg) { width: 1.1em; height: 1.1em; }
  .nav-row [data-next] { margin-left: auto; }
  .submit { min-height: 56px; font-size: 1rem; flex: 1 1 14rem; }
  :global(html:not(.js)) .js-only { display: none !important; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .privacy { font-size: 0.875rem; color: var(--ink-soft); margin: 0.5rem 0 1rem; }
  .privacy a { color: var(--ink); }
  .wa-alt { margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px dashed #b9ad95; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .btn-ghost-ink { --bg: transparent; --fg: var(--ink); --bd: var(--whatsapp); }
  .btn-ghost-ink :global(svg) { color: var(--whatsapp); }
  .btn-ghost-ink:hover { --bg: var(--whatsapp); --fg: #fff; }
  .btn-ghost-ink:hover :global(svg) { color: #fff; }
  .thumbs { display: flex; gap: 0.5rem; margin-top: 0.6rem; flex-wrap: wrap; }
  .thumbs :global(li) { width: 72px; height: 72px; border-radius: var(--radius); overflow: hidden; background: var(--ivory-2); }
  .thumbs :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .form-error { background: #fdf5f2; border: 1.5px solid var(--oxide); color: var(--oxide); font-weight: 700; padding: 0.9rem 1rem; margin-bottom: 1.5rem; border-radius: var(--radius); }

  .estimate { padding: 1.75rem 1.4rem 1.4rem; color: var(--ivory); }
  .est-amt { font-family: var(--font-display); font-size: 2.1rem; font-weight: 700; line-height: 1.1; margin: 0.35rem 0 0.5rem; }
  .est-amt.is-price { background: var(--gold-leaf); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .est-note { color: var(--steel-light); font-size: 0.875rem; }
  .estimate .rule-gold { margin: 1.1rem 0; max-width: 6rem; }
  .est-sum li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.35rem 0; font-size: 0.9375rem; border-bottom: 1px solid var(--iron-3); }
  .est-sum li span:first-child { color: var(--steel-light); }
  .est-small { font-size: 0.8125rem; color: var(--steel-light); margin-top: 1rem; line-height: 1.6; }
  @media (max-width: 979px) { .estimate { order: -1; } }
</style>
