---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Photo from '../../components/Photo.astro';
import CtaBand from '../../components/CtaBand.astro';
import type { Crumb } from '../../lib/schema.ts';

const all = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const crumbs: Crumb[] = [{ name: 'Home', url: '/' }, { name: 'Car Care Notes', url: '/guides/' }];
const waText = 'Hi Chris, I’ve got a car care question: …';
---
<Base
  title="Car Care Notes from Smith & Shine, Telford"
  description="Plain-English car care notes from Chris at Smith & Shine: mini vs full valet, how often to valet, paint correction vs ceramic, pet hair, and selling."
  waText={waText}
  crumbs={crumbs}
>
  <section class="ivory section">
    <div class="wrap">
      <Breadcrumbs crumbs={crumbs} tone="ivory" />
      <h1>Car Care Notes</h1>
      <p class="lede muted">Straight answers to the questions Chris gets asked on driveways across Telford.</p>
      <ol class="list" role="list">
        {all.map((g, i) => (
          <li class:list={[{ big: i === 0 }]}>
            <a href={`/guides/${g.id}/`}>
              <div class="photo"><Photo name={g.data.photo} alt={g.data.alt} sizes={i === 0 ? '(min-width: 900px) 50vw, 92vw' : '(min-width: 900px) 25vw, 92vw'} /></div>
              <div class="txt">
                <span class="no">No. {i + 1}</span>
                <h2>{g.data.h1}</h2>
                <p>{g.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <CtaBand waText={waText} />
</Base>
<style>
  h1 { font-size: var(--step-5); margin: 1rem 0 0.75rem; }
  .list { display: grid; gap: 2.5rem 2rem; margin-top: 3rem; }
  @media (min-width: 760px) { .list { grid-template-columns: repeat(2, 1fr); } .big { grid-column: span 2; } }
  @media (min-width: 1100px) { .list { grid-template-columns: repeat(4, 1fr); } .big { grid-column: span 2; grid-row: span 2; } }
  .list a { text-decoration: none; display: grid; gap: 1rem; }
  .photo { aspect-ratio: 4 / 3; }
  .big .photo { aspect-ratio: 4 / 3; }
  .no { font-family: var(--font-display); font-style: italic; color: var(--gold-ink); }
  h2 { font-size: var(--step-2); margin: 0.25rem 0 0.5rem; }
  .big h2 { font-size: var(--step-3); }
  .txt p { color: var(--ink-soft); font-size: 0.9375rem; }
  .list a:hover h2 { text-decoration: underline; text-decoration-color: var(--gold-ink); }
</style>
