---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewQuote from '../components/ReviewQuote.astro';
import CuppaNote from '../components/CuppaNote.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { reviews, googleRating, social, reviewFragments } from '../config/site.ts';
import type { Crumb } from '../lib/schema.ts';

const crumbs: Crumb[] = [{ name: 'Home', url: '/' }, { name: 'Reviews', url: '/reviews/' }];
const waText = 'Hi Chris, I’ve read the reviews and I’d like to book. My car is a … and my postcode is …';
const [first, ...rest] = reviews;
// No Review/AggregateRating schema on purpose: self-hosted reviews are self-serving to Google.
---
<Base
  title="Smith and Shine Reviews: Real Customers, Telford"
  description={`Smith & Shine reviews, word for word from Google: ${googleRating.label} five-star reviews and ${social.facebook.recommend} recommend on Facebook. Read what Telford says.`}
  waText={waText}
  crumbs={crumbs}
>
  <section class="iron rhero">
    <div class="wrap">
      <Breadcrumbs crumbs={crumbs} />
      <div class="rh-grid">
        <div>
          <h1>Smith &amp; Shine Reviews</h1>
          <p class="lead">Every word below is copied exactly from Google, typos and all. We haven’t tidied anything up, because that’s how real people write.</p>
        </div>
        <dl class="stats">
          <div><dt>Google</dt><dd><a href={social.googleReviews} target="_blank" rel="noopener">{googleRating.summary}</a></dd></div>
          <div><dt>Facebook</dt><dd>{social.facebook.recommend} recommend ({social.facebook.reviewCount} reviews)</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="ivory section-lg" aria-label="Customer reviews">
    <div class="wrap">
      <div class="lead-review"><ReviewQuote review={first} size="lg" /></div>
      <div class="cols">
        {rest.slice(0, 4).map((r) => <div class="cell"><ReviewQuote review={r} /></div>)}
        <div class="cell cuppa-cell"><CuppaNote /></div>
        {rest.slice(4).map((r) => <div class="cell"><ReviewQuote review={r} /></div>)}
      </div>
    </div>
  </section>

  <section class="ivory-2 section" aria-labelledby="themes-h">
    <div class="wrap themes">
      <div>
        <h2 id="themes-h">What keeps coming up</h2>
        <ul class="t-list" role="list">
          <li><b>Coming to the house.</b> “the ease of him coming to the house”</li>
          <li><b>Fitting people in.</b> “{reviewFragments.urgent.text}”</li>
          <li><b>Sticking to the price.</b> “sticks to a quoted price”</li>
          <li><b>Explaining the work.</b> “{reviewFragments.informative.text}”</li>
          <li><b>Coming back.</b> “See you next month :-)”</li>
        </ul>
      </div>
      <figure>
        <div class="photo"><Photo name="mercedes-a45-amg-matte-grey-gazebo-setup" alt="Smith & Shine gazebo set up on a customer’s driveway with a matte Mercedes-AMG underneath" sizes="(min-width: 900px) 30vw, 92vw" /></div>
        <figcaption class="caption">How most of these reviews started: the gazebo going up on a drive.</figcaption>
      </figure>
    </div>
  </section>

  <section class="ivory section" aria-labelledby="leave-h">
    <div class="wrap-mid leave">
      <h2 id="leave-h">Had your car done?</h2>
      <p>Reviews make a huge difference to a small family business. If you’ve got two minutes, Chris would really appreciate one.</p>
      <a class="btn btn-ink" href={social.googleWriteReview} target="_blank" rel="noopener">Leave us a Google review <Icon name="arrow" /></a>
    </div>
  </section>

  <CtaBand waText={waText} />
</Base>

<style>
  .rhero { padding: 0.5rem 0 var(--s-5); }
  .rh-grid { display: grid; gap: 2rem; align-items: end; margin-top: 1rem; }
  @media (min-width: 900px) { .rh-grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  h1 { font-size: var(--step-5); max-width: 7.2em; margin-bottom: 1rem; }
  .lead { font-size: var(--step-1); color: #e7e1d4; max-width: 40ch; }
  .stats { display: grid; gap: 1px; background: var(--iron-3); border: 1px solid var(--iron-3); }
  .stats div { background: var(--iron-2); padding: 1.1rem 1.25rem; }
  .stats dt { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); }
  .stats dd { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; margin-top: 0.2rem; }
  .stats a { color: var(--ivory); text-decoration-color: var(--gold); }
  .lead-review { max-width: 52rem; margin-bottom: 3.5rem; padding-bottom: 3rem; border-bottom: 1px solid #d9cfbb; }
  .cols { columns: 1; column-gap: 3.5rem; }
  @media (min-width: 760px) { .cols { columns: 2; } }
  @media (min-width: 1100px) { .cols { columns: 3; } }
  .cell { break-inside: avoid; margin-bottom: 3rem; }
  .cuppa-cell { padding: 1rem 0.5rem; }
  .themes { display: grid; gap: 2.5rem; }
  @media (min-width: 900px) { .themes { grid-template-columns: 1.3fr 0.7fr; gap: 5rem; align-items: center; } }
  .themes h2 { font-size: var(--step-4); margin-bottom: 1.5rem; }
  .t-list li { padding: 0.9rem 0; border-bottom: 1px solid #cfc3ab; font-family: var(--font-display); font-style: italic; font-size: 1.1rem; }
  .t-list b { font-family: var(--font-body); font-style: normal; font-weight: 700; display: block; font-size: 0.9375rem; margin-bottom: 0.2rem; }
  .themes .photo { aspect-ratio: 4 / 5; }
  .leave { text-align: center; display: grid; gap: 1rem; justify-items: center; }
  .leave h2 { font-size: var(--step-3); }
  .leave p { max-width: 44ch; color: var(--ink-soft); }
</style>
