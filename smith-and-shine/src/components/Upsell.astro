---
import Icon from './Icon.astro';
import { monthlyPlan, formatGBP } from '../config/site.ts';
// "Want it to stay like this?" on every valet page.
const from = formatGBP(monthlyPlan.prices[0].price);
---
<aside class="upsell" aria-label="Keep it looking like this">
  <a href={monthlyPlan.url} class="u u-month" data-upsell="monthly">
    <span class="label">Want it to stay like this?</span>
    <span class="big">Monthly plan from <span class="amt">{from}</span></span>
    <span class="small">Most of our regulars never go back to the car wash.</span>
    <Icon name="arrow" class="arr" />
  </a>
  <a href="/ceramic-coating-telford/" class="u u-cer" data-upsell="ceramic">
    <span class="label">Want the gloss to last?</span>
    <span class="big">Ask about ceramic</span>
    <span class="small">A hard, glossy layer that makes washing easier. Price on quote.</span>
    <Icon name="arrow" class="arr" />
  </a>
</aside>
<style>
  .upsell { display: grid; gap: 1px; background: var(--iron-3); border: 1px solid var(--iron-3); }
  @media (min-width: 760px) { .upsell { grid-template-columns: 1.4fr 1fr; } }
  .u {
    position: relative; display: grid; gap: 0.35rem; padding: 1.5rem 3.5rem 1.5rem 1.5rem; text-decoration: none;
    background: var(--iron); color: var(--ivory);
  }
  .u-month { background: var(--iron-2); }
  .u:hover .big { color: var(--gold-light); }
  .label { color: var(--gold); }
  .big { font-family: var(--font-display); font-size: var(--step-2); font-weight: 650; line-height: 1.15; }
  .amt { background: var(--gold-leaf); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .small { color: var(--steel-light); font-size: 0.9375rem; }
  .u :global(.arr) { position: absolute; right: 1.25rem; top: 50%; width: 1.5rem; height: 1.5rem; color: var(--gold); transform: translateY(-50%); transition: transform 0.25s var(--ease); }
  .u:hover :global(.arr) { transform: translate(4px, -50%); }
</style>
