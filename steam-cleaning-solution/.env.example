# Copy to .env for local dev. Set the real values in Netlify → Site settings → Environment variables.
# Never commit real secrets.

# Preview: noindex + disallow-all + Primo Partners ribbon. Set to false at go-live.
PREVIEW_MODE=true
SITE_URL=https://steam-cleaning-solution-cardiff.netlify.app

# Email (Resend)
RESEND_API_KEY=
# Preview → itsprimopartners@gmail.com   Go-live → Steamcleaning769@gmail.com
QUOTE_TO_EMAIL=itsprimopartners@gmail.com
# Use onboarding@resend.dev until the business domain is verified in Resend
QUOTE_FROM_EMAIL=onboarding@resend.dev

# /api/quotes.csv Basic Auth
ADMIN_USER=
ADMIN_PASS=

# Optional
PUBLIC_GA4_ID=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
RATE_SALT=
