---
/**
 * Framed editorial plate: a print on a mount. 10px paper margin, 1px oak inner rule,
 * small-caps caption tag. Max 560px wide; never upscaled past the 720px source.
 */
import { Picture } from 'astro:assets';
import { photo } from '../lib/photos';
import { PREVIEW_MODE } from '../config/site';
interface Props {
  photoKey: string;
  alt: string;
  caption: string;
  eager?: boolean;
  tilt?: boolean;
  class?: string;
}
const { photoKey, alt, caption, eager = false, tilt = false, class: cls } = Astro.props;
const img = photo(photoKey);
const base = 560;
const widths = img ? [...new Set([Math.min(base, img.width), Math.min(Math.round(base * 1.5), img.width)])] : [];
---
{(img || PREVIEW_MODE) && (
  <figure class:list={['plate', { 'plate--tilt': tilt }, cls]}>
    <div class="plate__mount">
      {img ? (
        <Picture
          src={img}
          alt={alt}
          formats={['avif', 'webp']}
          widths={widths}
          sizes="(max-width: 600px) calc(100vw - 52px), 540px"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority="auto"
          decoding="async"
          class="plate__img"
        />
      ) : (
        <div class="plate__pending" role="img" aria-label={`Photo to come: ${alt}`}>
          <span class="label">Photo to come</span>
          <span class="plate__file">{photoKey}.jpg</span>
        </div>
      )}
    </div>
    <figcaption class="plate__tag label">{caption}</figcaption>
  </figure>
)}

<style>
  .plate { max-width: 560px; margin: 0; }
  .plate__mount {
    background: var(--paper);
    padding: 10px;
    box-shadow: 0 1px 0 rgba(19, 32, 26, 0.06), 0 18px 40px -24px rgba(19, 32, 26, 0.28);
    position: relative;
  }
  .plate__mount::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid var(--oak);
    pointer-events: none;
  }
  .plate__mount :global(img) { width: 100%; height: auto; }
  .plate__pending {
    aspect-ratio: 4 / 3;
    background: var(--sage-50);
    display: grid;
    place-content: center;
    gap: 0.4rem;
    text-align: center;
    padding: 1.5rem;
  }
  .plate__file { font-size: 0.8rem; color: var(--muted); word-break: break-all; }
  .plate__tag {
    display: inline-block;
    margin-top: 0.85rem;
    margin-left: 10px;
    padding: 0.35rem 0.7rem;
    background: var(--linen);
    border: 1px solid var(--sage-200);
    color: var(--ink);
  }
  .plate--tilt .plate__mount { transform: rotate(-1.2deg); }
</style>
