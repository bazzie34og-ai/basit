---
import { towns, cardiffNeighbourhoods, business } from '../../config/site';
interface Props { headingLevel?: 'h2'; compact?: boolean }
---
<section class="areas section" aria-labelledby="areas-h">
  <div class="wrap areas__grid">
    <div>
      <p class="label label--forest">Where we work</p>
      <h2 id="areas-h">Cardiff, Newport <em>and around</em></h2>
      <p class="areas__intro">Not sure if you’re covered? Send your postcode with your photo and we’ll tell you straight away.</p>
      {business.google.gbpMapsUrl && <p><a class="text-link" href={business.google.gbpMapsUrl} rel="noopener">See us on Google Maps</a></p>}
    </div>
    <div>
      <ul class="areas__towns">
        {towns.map((t) => (
          <li>
            <a href={t.path}><span class="areas__name">{t.name}</span><span class="areas__pc label">{t.postcodes.join(' ')}</span></a>
          </li>
        ))}
      </ul>
      <p class="areas__hoods"><span class="label">Across Cardiff</span> {cardiffNeighbourhoods.join(' · ')}</p>
    </div>
  </div>
</section>
<style>
  .areas__grid { display: grid; gap: 2.5rem; }
  .areas h2 { margin-top: 0.5rem; max-width: 12ch; }
  .areas__intro { margin-top: 1rem; color: var(--muted); max-width: 34ch; }
  .areas__towns { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--sage-200); }
  .areas__towns a { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: 0.9rem; border-bottom: 1px solid var(--sage-200); text-decoration: none; color: var(--ink); min-height: 44px; }
  .areas__name { font-family: var(--font-display); font-size: 1.7rem; line-height: 1.1; }
  .areas__towns a:hover .areas__name { color: var(--forest); }
  .areas__pc { text-align: right; }
  .areas__hoods { margin-top: 1.75rem; line-height: 1.9; color: var(--ink); }
  .areas__hoods .label { margin-right: 0.6rem; }
  @media (min-width: 700px) { .areas__towns { grid-template-columns: 1fr 1fr; column-gap: 2.5rem; } }
  @media (min-width: 960px) { .areas__grid { grid-template-columns: 4fr 7fr; gap: 4rem; } }
</style>
