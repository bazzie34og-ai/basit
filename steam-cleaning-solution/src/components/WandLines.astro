---
/**
 * Signature motif. Used in exactly four places: hero quote panel, the divider before
 * "The visit", the footer strip, and the 404.
 */
import { wandPaths } from '../lib/wand';
interface Props {
  variant: 'panel' | 'divider' | 'strip' | 'field';
  tone?: 'linen' | 'forest';
  class?: string;
}
const { variant, tone = 'linen', class: cls = '' } = Astro.props;
const presets = {
  panel: { width: 520, height: 640, lanes: 8, seed: 11, step: 0.24, rotate: -9, bleed: 140 },
  divider: { width: 1240, height: 92, lanes: 2, seed: 3, step: 0.3, rotate: 0, bleed: 0 },
  strip: { width: 1240, height: 54, lanes: 1, seed: 5, step: 0.3, rotate: 0, bleed: 0 },
  field: { width: 900, height: 420, lanes: 6, seed: 19, step: 0.26, rotate: -5, bleed: 120 },
} as const;
const p = presets[variant];
const b = p.bleed;
const paths = wandPaths({ ...p, width: p.width + b * 2, height: p.height + b * 2, lanes: p.lanes });
const pad = 0;
---
<svg
  class:list={['wand', `wand--${variant}`, `wand--${tone}`, cls]}
  viewBox={`${-pad} ${-pad} ${p.width + pad * 2} ${p.height + pad * 2}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  data-wand
>
  <g transform={p.rotate ? `rotate(${p.rotate} ${p.width / 2} ${p.height / 2}) translate(${-b} ${-b})` : undefined}>
    {paths.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
  </g>
</svg>

<style>
  .wand { display: block; width: 100%; height: 100%; pointer-events: none; }
  .wand path {
    fill: none;
    stroke: var(--sage-200);
    stroke-width: 1.4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
  }
  .wand--forest path { stroke: #2C5E47; stroke-width: 1.3; }
  .wand--divider { height: 92px; }
  .wand--strip { height: 54px; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .wand:not(.is-drawn) path { stroke-dashoffset: 1; }
    .wand.is-drawn path {
      transition: stroke-dashoffset 1.8s cubic-bezier(.45, .05, .3, 1);
      transition-delay: calc(var(--i) * 140ms);
    }
  }
</style>
