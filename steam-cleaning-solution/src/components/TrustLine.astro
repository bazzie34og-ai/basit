---
import { trustItems } from '../config/site';
interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;
---
<ul class:list={['trust', `trust--${tone}`]} aria-label="Why people trust us">
  {trustItems().map((t) => <li>{t}</li>)}
</ul>
<style>
  .trust { list-style: none; padding: 0; margin-top: 1.4rem; display: flex; flex-wrap: wrap; gap: 0.3rem 0; font-size: 0.92rem; font-weight: 500; color: var(--muted); }
  .trust li { display: inline-flex; align-items: center; }
  .trust li + li::before { content: ''; width: 4px; height: 4px; border-radius: 50%; background: var(--sage-500); margin-inline: 0.7rem; }
  .trust--dark { color: var(--on-dark-muted); }
</style>
