---
interface Props { name: 'whatsapp' | 'phone' | 'camera' | 'heart' | 'arrow'; class?: string }
const { name, class: cls } = Astro.props;
---
{name === 'whatsapp' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.2a9.7 9.7 0 0 0-8.3 14.8L2.4 21.6l4.8-1.3A9.7 9.7 0 1 0 12 2.2Zm0 17.7a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.8.8-2.8-.2-.3A8 8 0 1 1 12 19.9Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.9 2c0 1.2.9 2.3 1 2.5.1.2 1.7 2.6 4.2 3.7 1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.2Z"/></svg>
)}
{name === 'phone' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 3.2c.4-.1.9.1 1.1.5l1.6 3.4c.2.4.1.9-.2 1.2L7.6 9.7a12 12 0 0 0 6.7 6.7l1.4-1.5c.3-.3.8-.4 1.2-.2l3.4 1.6c.4.2.6.7.5 1.1l-.6 2.6c-.1.5-.6.8-1.1.8A16.6 16.6 0 0 1 3.2 4.9c0-.5.3-1 .8-1.1l2.6-.6Z"/></svg>
)}
{name === 'camera' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M9 4h6l1.5 2H20a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3.5L9 4Zm3 4.5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0 1.8a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4Z"/></svg>
)}
{name === 'heart' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="var(--brass)" d="M12 20.5c-.6-.4-8-5.3-8-10.2C4 7.7 6 5.8 8.4 5.8c1.5 0 2.8.8 3.6 2 .8-1.2 2.1-2 3.6-2C18 5.8 20 7.7 20 10.3c0 4.9-7.4 9.8-8 10.2Z"/></svg>
)}
{name === 'arrow' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M5 12h13m-5-5 5 5-5 5"/></svg>
)}
