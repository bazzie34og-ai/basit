---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
{items.length > 1 && (
  <nav class="crumbs wrap" aria-label="Breadcrumb">
    <ol>
      {items.map((it, i) => (
        <li>{i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
      ))}
    </ol>
  </nav>
)}
<style>
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0 0.5rem; font-size: 0.875rem; color: var(--muted); padding-top: 1.1rem; }
  .crumbs li { display: inline-flex; align-items: center; }
  .crumbs li + li::before { content: '/'; color: var(--sage-500); margin-right: 0.5rem; }
  .crumbs a { color: var(--muted); display: inline-flex; min-height: 44px; align-items: center; }
  .crumbs span { min-height: 44px; display: inline-flex; align-items: center; }
</style>
