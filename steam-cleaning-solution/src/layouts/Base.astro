---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-500.css';
import '@fontsource/hanken-grotesk/latin-600.css';
import serifWoff2 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalicWoff2 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sansWoff2 from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business, PREVIEW_MODE, GA4_ID } from '../config/site';
import { businessSchema, websiteSchema, breadcrumbSchema } from '../lib/schema';
import { canonical, ogPath } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  breadcrumbs?: { name: string; href: string }[];
  waSubject?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogTitle?: string;
  bodyClass?: string;
}
const { title, description, path, breadcrumbs = [], waSubject = 'cleaning', schema = [], noindex = false, ogTitle, bodyClass } = Astro.props;

if (import.meta.env.DEV) {
  if (title.length > 60) console.warn(`[seo] title > 60 chars on ${path}: ${title}`);
  if (description.length > 155) console.warn(`[seo] description > 155 chars on ${path}`);
}

const robots = PREVIEW_MODE || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const url = canonical(path);
const og = canonical(ogPath(path));
const crumbs = breadcrumbs.length ? [{ name: 'Home', href: '/' }, ...breadcrumbs] : [];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [businessSchema(), websiteSchema(), ...(crumbs.length ? [breadcrumbSchema(crumbs)] : []), ...schema],
};
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="robots" content={robots} />
  <meta name="theme-color" content="#F4F1E8" />
  <link rel="preload" href={serifWoff2} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={serifItalicWoff2} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <meta property="og:type" content={path.startsWith('/guides/') ? 'article' : 'website'} />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:site_name" content={business.shortName} />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />

  <script is:inline>document.documentElement.classList.add('js')</script>
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
</head>
<body class={bodyClass} data-ga4={GA4_ID || undefined}>
  <a class="skip" href="#main">Skip to content</a>
  {PREVIEW_MODE && (
    <div class="ribbon" data-ribbon>
      <p>Preview prepared for {business.name} by Abdul Basit · Primo Partners</p>
      <button type="button" class="ribbon__close" data-ribbon-close hidden aria-label="Dismiss preview notice">×</button>
    </div>
  )}
  <Header path={path} waSubject={waSubject} />
  <Breadcrumbs items={crumbs} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <slot name="pre-footer" />
  <Footer waSubject={waSubject} />
  <MobileBar waSubject={waSubject} />
  {GA4_ID && (
    <div class="consent" data-consent hidden>
      <p>May we use Google Analytics to see which pages help people? No ads, no selling data.</p>
      <div class="consent__btns">
        <button type="button" class="btn btn--primary" data-consent-yes>That’s fine</button>
        <button type="button" class="btn btn--ghost" data-consent-no>No thanks</button>
      </div>
    </div>
  )}
  <script>
    import '../scripts/site.ts';
  </script>
</body>
</html>

<style is:global>
  .skip { position: absolute; left: 1rem; top: -100px; z-index: 100; background: var(--forest); color: var(--linen); padding: 0.75rem 1rem; border-radius: var(--radius-btn); font-weight: 600; }
  .skip:focus { top: 1rem; }
  main:focus { outline: none; }
  .ribbon { display: flex; align-items: center; justify-content: center; gap: 0.75rem; background: var(--sage-50); color: var(--ink); font-size: 0.8rem; padding: 0.35rem var(--gutter); border-bottom: 1px solid var(--sage-200); text-align: center; }
  .ribbon[hidden] { display: none; }
  .ribbon__close { background: none; border: 0; font-size: 1.2rem; line-height: 1; min-width: 44px; min-height: 36px; color: var(--muted); }
  .ribbon__close[hidden] { display: none; }
  .consent { position: fixed; left: 12px; right: 12px; bottom: calc(var(--mobile-bar-h) + 20px); z-index: 45; max-width: 520px; margin-inline: auto; background: var(--paper); border: 1px solid var(--sage-200); padding: 1rem 1.1rem; border-radius: var(--radius); box-shadow: 0 20px 40px -24px rgba(19, 32, 26, 0.4); font-size: 0.95rem; }
  .consent[hidden] { display: none; }
  .consent__btns { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
  .consent__btns .btn { min-height: 44px; padding: 0.5em 1em; font-size: 0.9rem; }
  @media (min-width: 768px) { .consent { bottom: 20px; left: auto; right: 20px; } }
</style>
