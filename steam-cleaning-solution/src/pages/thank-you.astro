---
import Base from '../layouts/Base.astro';
import Ctas from '../components/Ctas.astro';
import { business } from '../config/site';
---
<Base title="Thank You | Steam Cleaning Solution" description="Your quote request has arrived. Here is what happens next." path="/thank-you/" noindex>
  <section class="ty wrap">
    <p class="label label--forest">Request received</p>
    <h1>Thank you. <em>It’s with us.</em></h1>
    <ol class="ty__next">
      <li><span class="label">Next</span><p>We look at your photos and reply with a fixed price, {business.replyTime}.</p></li>
      <li><span class="label">Then</span><p>You choose a day. We confirm by message the day before, and call when we’re on the way.</p></li>
      <li><span class="label">On the day</span><p>You pay the price we quoted, nothing more.</p></li>
    </ol>
    <p class="ty__wa">Want to add more photos, or in a hurry? Message us on WhatsApp.</p>
    <Ctas waSubject="cleaning (I've just sent the form)" where="thank_you" />
    {business.google.gbpReviewUrl && <p class="ty__review">Had a clean with us before? <a href={business.google.gbpReviewUrl} rel="noopener">Leave us a Google review</a>. It really helps a small local business.</p>}
  </section>
</Base>
<style>
  .ty { padding-block: clamp(2rem, 6vw, 5rem) var(--s-9); max-width: 900px; margin-left: max(var(--gutter), calc((100vw - var(--wrap)) / 2)); }
  .ty h1 { margin-top: 0.8rem; }
  .ty__next { list-style: none; padding: 0; margin: 2.5rem 0; border-left: 3px solid var(--oak); background: var(--paper); padding: 1.5rem 1.75rem; }
  .ty__next li { display: grid; gap: 0.2rem; padding-block: 0.8rem; }
  .ty__next li + li { border-top: 1px dashed var(--sage-200); }
  .ty__next p { font-family: var(--font-display); font-size: 1.4rem; line-height: 1.3; }
  .ty__wa { margin-bottom: 1.25rem; }
  .ty__review { margin-top: 2rem; }
</style>
