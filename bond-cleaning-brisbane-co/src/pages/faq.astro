---
// Intent tier 4 (researching). Primary: bond cleaning faq.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqGroups, byGroup } from '../data/faqs';
import { flagOn } from '../lib/tpl';
import { faqPage } from '../lib/schema';
const groups = faqGroups.map((g) => ({ ...g, items: byGroup(g.key).filter((f) => !f.flag || flagOn(f.flag)) }));
const all = groups.flatMap((g) => g.items);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'FAQ', href: '/faq/' }];
---
<BaseLayout title="Bond Cleaning FAQs Queensland | Bond Cleaning Brisbane Co." description="Bond cleaning questions answered with the Queensland rules: do you need professional cleaning, carpets, pest control, fair wear and tear, prices, the guarantee and worries about cleaners." crumbs={crumbs} schema={[faqPage(all)]}>
  <PageHero eyebrow={`${all.length} answers · RTA sources linked`} h1="Bond Cleaning Questions, Answered (QLD Rules)">
    <p class="lead">Our bond cleaning FAQ answers what Brisbane renters actually ask, starting with the answer. Do I need professional bond cleaning in QLD? Is carpet cleaning at end of lease required in QLD? Where a rule comes from the Residential Tenancies Authority (RTA), we link to it. A bond clean, end of lease clean, vacate clean and exit clean are the same thing, so every answer applies to all four.</p>
  </PageHero>
  <section class="section section--bg">
    <div class="container container--narrow">
      <nav class="faq-jump" aria-label="FAQ sections">
        {groups.map((g) => <a href={`#${g.anchor}`}>{g.key}. {g.title.split(' (')[0]}</a>)}
      </nav>
      {groups.map((g) => (
        <section id={g.anchor} aria-labelledby={`${g.anchor}-h2`} style="margin-bottom:56px">
          <p class="eyebrow">Section {g.key}</p>
          <h2 id={`${g.anchor}-h2`}>{g.title}</h2>
          <FaqList items={g.items} />
        </section>
      ))}
    </div>
  </section>
  <CtaBand h2="Still have a question?" p="Call, WhatsApp or send photos for a fixed price. We reply within {replyTime} during business hours." />
</BaseLayout>
