---
/**
 * Suburb page template. Unique copy per suburb comes from src/content/areas/.
 * Shared components only: what's included, process, CTA, footer.
 * Tier 2 (ready to book): quote form above the fold, suburb pre-selected.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import QuoteForm from '../QuoteForm.astro';
import PromiseChips from '../PromiseChips.astro';
import TrustRow from '../TrustRow.astro';
import PhotoGrid from '../PhotoGrid.astro';
import Steps from '../Steps.astro';
import IncludedRooms from '../IncludedRooms.astro';
import FaqList from '../FaqList.astro';
import CtaBand from '../CtaBand.astro';
import RealJob from '../RealJob.astro';
import NorthsideMap from '../NorthsideMap.astro';
import { business } from '../../config/site';
import { serviceBySlug, areaBySlug, areaUrl, groupOfArea } from '../../lib/data';
import { areaContent } from '../../content/areas/index';
import { t, telHref, waHref, flagOn } from '../../lib/tpl';
import { serviceSchema, faqPage } from '../../lib/schema';
import type { AreaData } from '../../lib/types';

interface Props { area: AreaData }
const { area } = Astro.props;
const c = areaContent[area.slug];
const group = groupOfArea(area.slug)!;
const faqs = c.faqs.filter((f) => !f.flag || flagOn(f.flag));
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Areas', href: '/areas/' },
  { name: `Bond Cleaning ${area.name}`, href: area.url },
];
const schema = [
  serviceSchema({ name: `Bond Cleaning in ${area.name}`, serviceType: 'Bond cleaning', url: area.url, description: c.intro, area: area.slug }),
  faqPage(faqs),
];
const waMsg = `Hi, I'd like a bond clean quote for a [x] bed in ${area.name}`;
---
<BaseLayout title={area.title} description={area.meta} crumbs={crumbs} schema={schema}>
  <Fragment set:html={`<!-- Intent tier ${c.tier} · ${area.primary} · persona: ${c.persona} -->`} />
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__grid">
        <div>
          <p class="eyebrow">{group.name} · {area.name} {area.pc}</p>
          <h1>{area.h1}</h1>
          <div class="lead hero__lead" set:html={t(c.intro)} />
          <div class="btn-row btn-row--stack">
            <a class="btn btn--primary btn--lg" href="#quote">Get my fixed price</a>
            <a class="btn btn--secondary btn--lg" href={telHref()} data-track="call_click" data-track-location="area-hero"><Icon name="phone" />Call {business.phone}</a>
            <a class="btn btn--secondary btn--lg" href={waHref(waMsg)} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-location="area-hero"><Icon name="whatsapp" />WhatsApp</a>
          </div>
          <PromiseChips />
          <TrustRow />
        </div>
        <div>
          <QuoteForm id="qt" anchor suburb={area.name} location={`${area.slug}-top`} title={`Get your ${area.name} price`} />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bg" aria-labelledby="local-h2">
    <div class="container">
      <div class="split split--top">
        <div class="prose">
          <p class="eyebrow">Local knowledge</p>
          <h2 id="local-h2">{c.local.h2}</h2>
          {c.local.paras.map((p) => <p set:html={t(p)} />)}
          <h3>{c.access.h3}</h3>
          <div set:html={t(c.access.html)} />
          <h3>{c.checks.h3}</h3>
          <div set:html={t(c.checks.html)} />
          <ul class="ticks">{c.checks.items.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="map-card reveal" role="img" aria-label={`Bond cleaning ${area.name}: map of ${area.name} ${area.pc} and the nearby suburbs we clean`}>
          <NorthsideMap current={area.slug} links />
          <p class="small muted shared" style="margin:10px 4px 0">{area.name} {area.pc} and the 19 other suburbs on our Northside runs.</p>
        </div>
      </div>
    </div>
  </section>

  <RealJob job={c.realJob} suburb={area.name} />

  <section class="section" aria-labelledby="extra-h2">
    <div class="container prose">
      <p class="eyebrow">{area.name} specifics</p>
      <h2 id="extra-h2">{c.extra.h2}</h2>
      <div set:html={t(c.extra.html)} />
    </div>
  </section>

  <section class="section section--bg" aria-labelledby="inc-h2">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What's included</p>
        <h2 id="inc-h2">What's included in every bond clean</h2>
        <p>The same room-by-room list on every job. See the <a href="/bond-cleaning-checklist/">full bond cleaning checklist</a> for every item.</p>
      </div>
      <IncludedRooms />
    </div>
  </section>

  <section class="section" aria-labelledby="ba-h2">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Before and after</p>
        <h2 id="ba-h2">Results from our Brisbane bond cleans</h2>
        <p>{c.photoIntro}</p>
      </div>
      <PhotoGrid keys={c.photos} cols={2} />
    </div>
  </section>

  <Steps bg />

  <section class="section" aria-labelledby="svc-h2">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2 id="svc-h2">{c.servicesH2}</h2>
      </div>
      <div class="grid grid-3">
        {c.services.map((s) => {
          const svc = serviceBySlug(s.slug);
          return (
            <article class="card card--flat">
              <h3 style="font-size:1.125rem">{svc.name}</h3>
              <p class="muted small">{s.why[0].toUpperCase() + s.why.slice(1)}.</p>
              <a class="card__more" href={svc.url}>{s.anchor[0].toUpperCase() + s.anchor.slice(1)}</a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--bg" aria-labelledby="faq-h2">
    <div class="container container--narrow">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-h2">{area.name} bond clean questions</h2>
      </div>
      <FaqList items={faqs} />
    </div>
  </section>

  <section class="section" aria-labelledby="near-h2">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Nearby</p>
        <h2 id="near-h2">Nearby areas we clean</h2>
        <p>{c.nearbyIntro}</p>
      </div>
      <ul class="area-chips">
        {area.near.map((slug) => <li><a href={areaUrl(slug)}>Bond cleaning {areaBySlug(slug).name}</a></li>)}
      </ul>
      <p class="mt-2 shared">New to us? Start with how our <a href="/">bond cleaning Brisbane</a> service works, or see <a href="/areas/">all 20 areas we clean</a>.</p>
    </div>
  </section>

  <section class="section section--bg quote-section" aria-labelledby="bottom-quote-h2">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">{area.name} {area.pc}</p>
        <h2 id="bottom-quote-h2">Get your {area.name} fixed price</h2>
      </div>
      <QuoteForm id="qb" suburb={area.name} location={`${area.slug}-bottom`} />
    </div>
  </section>

  <CtaBand h2={c.cta.h2} p={c.cta.p} quoteHref="#quote" />
</BaseLayout>
