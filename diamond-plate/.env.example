# Copy to .env for local dev. On Netlify, set these under Site configuration → Environment variables
# (scope: Builds + Functions). Never commit real values.

# --- Site / build ---
# true (default) = noindex on every page, robots.txt "Disallow: /", preview ribbon, leads to Primo Partners.
PREVIEW_MODE=true
# Canonical origin, no trailing slash. Drives canonicals, sitemap, OG URLs and schema.
SITE_URL=https://diamond-plate-brisbane.netlify.app
# Optional: GA4 measurement id (G-XXXXXXX). GA only loads after the visitor accepts the consent bar.
PUBLIC_GA4_ID=
# Optional: Cloudflare Turnstile site key (public, used at build time). Pair with TURNSTILE_SECRET.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Lead pipeline (netlify/functions/quote.mjs) ---
# Resend API key (free tier): https://resend.com/api-keys
RESEND_API_KEY=
# Where new leads are emailed. Preview: itsprimopartners@gmail.com. Go-live: infoqld@diamondplate.com.au
# Comma-separate for several recipients.
LEAD_TO_EMAIL=itsprimopartners@gmail.com
# Sender. Use onboarding@resend.dev until diamondplate.com.au is verified in Resend, then quotes@diamondplate.com.au
LEAD_FROM_EMAIL=Diamond Plate Leads <onboarding@resend.dev>
# Optional: Discord / Slack / Google Chat incoming webhook for an instant phone alert.
NOTIFY_WEBHOOK_URL=
# Optional: Cloudflare Turnstile secret. If unset, Turnstile is skipped.
TURNSTILE_SECRET=
# Optional: salt for hashing IPs in the rate limiter (any random string).
RATE_LIMIT_SALT=

# --- Lead export (netlify/functions/leads-export.mjs → /api/leads.csv) ---
# HTTP Basic Auth. The export is disabled until both are set.
ADMIN_USER=
ADMIN_PASS=
