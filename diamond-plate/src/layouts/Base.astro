---
import '@fontsource/saira-condensed/latin-700.css';
import '@fontsource/saira-condensed/latin-800.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '../styles/tokens.css';
import displayFont from '@fontsource/saira-condensed/files/saira-condensed-latin-800-normal.woff2?url';
import bodyFont from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { GA4_ID, PREVIEW_MODE, SITE_URL, business, money, priceFrom, warrantyYears } from '../config/site';
import { ogSlug } from '../config/routes';
import { breadcrumbSchema, businessSchema, type Crumb } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  h1: string;
  noindex?: boolean;
  /** Breadcrumb trail, excluding Home. Omit on the home page. */
  crumbs?: Crumb[];
  schema?: object[];
  /** Preload the LCP hero image: { srcset, type, href } */
  preload?: { href: string; srcset?: string; type?: string };
  quoteHref?: string;
  ogType?: 'website' | 'article';
  bodyAttrs?: Record<string, string>;
}

const { title, description, h1, noindex = false, crumbs, schema = [], preload, quoteHref, ogType = 'website', bodyAttrs = {} } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE_URL + '/').href;
const ogImage = new URL(`/og/${ogSlug(path === '/404.html' ? '/404/' : path)}.png`, SITE_URL + '/').href;
const robots = PREVIEW_MODE || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const trail = crumbs ? [{ name: 'Home', path: '/' }, ...crumbs] : null;
const ld = [businessSchema(), ...(trail ? [breadcrumbSchema(trail)] : []), ...schema];
if (import.meta.env.DEV) {
  if (title.length > 60) console.warn(`[seo] title > 60 chars on ${path}: ${title}`);
  if (description.length > 155) console.warn(`[seo] description > 155 chars on ${path}`);
}
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#05070B" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" as="image" href={preload.href} imagesrcset={preload.srcset} type={preload.type} fetchpriority="high" />}

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${h1}. From ${money(priceFrom)}, ${warrantyYears}-year warranty.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {ld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body {...bodyAttrs}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="dp-config" hidden data-ga4={GA4_ID} data-preview={String(PREVIEW_MODE)}></div>
    {PREVIEW_MODE && (
      <div class="ribbon" data-ribbon role="note">
        <p>Preview prepared for Diamond Plate Brisbane by Primo Partners</p>
        <button type="button" aria-label="Dismiss preview notice">×</button>
      </div>
    )}
    <Header />
    <main id="main" tabindex="-1">
      {trail && <Breadcrumbs trail={trail} />}
      <slot />
    </main>
    <Footer />
    <MobileBar quoteHref={quoteHref} />
    {GA4_ID && (
      <div class="consent" data-consent hidden role="region" aria-label="Cookie consent">
        <p>We use Google Analytics cookies to see which pages help people. OK with that?</p>
        <div><button type="button" class="btn btn-ghost" data-choice="no">Decline</button><button type="button" class="btn btn-primary" data-choice="yes">Accept</button></div>
      </div>
    )}
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
  .ribbon {
    position: relative; z-index: 51;
    display: flex; align-items: center; justify-content: center; gap: 12px;
    min-height: 36px; padding: 4px 48px;
    background: var(--graphite); border-bottom: 1px solid var(--line);
    font: 500 0.78rem/1.3 var(--font-body); letter-spacing: 0.04em; color: var(--chrome); text-align: center;
  }
  .ribbon p { margin: 0; }
  .ribbon[hidden] { display: none; }
  .ribbon button {
    position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
    width: 44px; height: 44px; border: 0; background: none; color: var(--chrome); font-size: 1.3rem; cursor: pointer;
  }
  .consent {
    position: fixed; z-index: 70; left: 12px; right: 12px; bottom: calc(var(--bar-h) + 12px + env(safe-area-inset-bottom));
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
    max-width: 760px; margin-inline: auto; padding: 12px 16px;
    background: var(--panel); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 20px 50px -20px #000;
    font-size: 0.88rem; color: var(--chrome);
  }
  .consent[hidden] { display: none; }
  .consent p { margin: 0; flex: 1 1 260px; }
  .consent div { display: flex; gap: 8px; }
  .consent .btn { --h: 44px; padding: 0 1.1em; }
  @media (min-width: 768px) { .consent { bottom: 16px; } }
</style>
