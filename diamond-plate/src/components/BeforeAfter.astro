---
import { getImage } from 'astro:assets';
import { photos } from '../config/photos';
/** Accessible before/after slider: native range input (keyboard arrows) + hexagon handle. Works as a static 50/50 without JS. */
interface Props { caption?: string }
const { caption = 'Diamond Plate work: Subaru BRZ before and after decontamination, clay bar and coating.' } = Astro.props;
const W = 720;
const H = 850;
const opts = { width: W, height: H, fit: 'cover' as const, position: 'top' };
const [bA, bW, aA, aW, bJ, aJ] = await Promise.all([
  getImage({ src: photos.brzBefore.src, format: 'avif', ...opts }),
  getImage({ src: photos.brzBefore.src, format: 'webp', ...opts }),
  getImage({ src: photos.brzAfter.src, format: 'avif', ...opts }),
  getImage({ src: photos.brzAfter.src, format: 'webp', ...opts }),
  getImage({ src: photos.brzBefore.src, format: 'jpg', ...opts }),
  getImage({ src: photos.brzAfter.src, format: 'jpg', ...opts }),
]);
---
<figure class="ba-fig">
  <div class="ba frame" data-ba style="--pos: 50%">
    <picture>
      <source srcset={aA.src} type="image/avif" />
      <source srcset={aW.src} type="image/webp" />
      <img src={aJ.src} alt={photos.brzAfter.alt} width={W} height={H} loading="lazy" decoding="async" class="ba-img" />
    </picture>
    <div class="ba-before">
      <picture>
        <source srcset={bA.src} type="image/avif" />
        <source srcset={bW.src} type="image/webp" />
        <img src={bJ.src} alt={photos.brzBefore.alt} width={W} height={H} loading="lazy" decoding="async" class="ba-img" />
      </picture>
    </div>
    <span class="lbl l" aria-hidden="true">Before</span>
    <span class="lbl r" aria-hidden="true">After</span>
    <span class="handle" aria-hidden="true">
      <svg viewBox="0 0 40 46"><path d="M20 1.5 38.5 12v22L20 44.5 1.5 34V12z" /><path d="m15 17-6 6 6 6M25 17l6 6-6 6" class="arr" /></svg>
    </span>
    <label class="visually-hidden" for="ba-range">Before and after comparison: move to reveal more of the before or after photo</label>
    <input id="ba-range" type="range" min="0" max="100" value="50" step="1" />
  </div>
  <figcaption>{caption}</figcaption>
</figure>
<style>
  .ba-fig { max-width: 560px; margin-inline: auto; }
  .ba { position: relative; aspect-ratio: 720 / 850; user-select: none; touch-action: pan-y; }
  .ba-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba-before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba::before { content: ''; position: absolute; z-index: 2; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: var(--grad); box-shadow: 0 0 18px rgba(56, 200, 255, 0.8); pointer-events: none; }
  .handle { position: absolute; z-index: 3; top: 50%; left: var(--pos); width: 46px; height: 52px; transform: translate(-50%, -50%); pointer-events: none; filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.6)); }
  .handle path:first-child { fill: var(--ink); stroke: var(--ice); stroke-width: 2; }
  .handle .arr { fill: none; stroke: var(--white); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .lbl { position: absolute; z-index: 2; top: 14px; padding: 6px 10px; border-radius: 999px; background: rgba(5, 7, 11, 0.75); font: 700 0.72rem/1 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase; }
  .l { left: 14px; }
  .r { right: 14px; }
  input[type='range'] { position: absolute; z-index: 4; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .ba:has(input:focus-visible) .handle path:first-child { stroke: #fff; stroke-width: 3; }
  .ba:has(input:focus-visible) { outline: 3px solid var(--ice); outline-offset: 3px; }
</style>
