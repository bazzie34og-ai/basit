---
import type { Crumb } from '../lib/schema';
interface Props { trail: Crumb[] }
const { trail } = Astro.props;
---
<nav class="crumbs wrap" aria-label="Breadcrumb">
  <ol>
    {trail.map((c, i) => (
      <li>{i < trail.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { padding-top: 18px; position: relative; z-index: 2; }
  ol { display: flex; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; font-size: 0.85rem; color: var(--chrome); }
  li + li::before { content: '/'; margin: 0 10px; opacity: 0.5; }
  a { color: var(--chrome); display: inline-block; padding: 10px 0; }
  span { display: inline-block; padding: 10px 0; color: var(--white); }
</style>
