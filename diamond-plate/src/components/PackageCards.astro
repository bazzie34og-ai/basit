---
import Icon from './Icon.astro';
import { money, packages, priceNote, addOns } from '../config/site';
interface Props { quoteBase?: string; showNote?: boolean }
const { quoteBase = '/get-a-quote/', showNote = true } = Astro.props;
---
<div class="pk-grid" data-reveal-group data-price-view>
  {packages.map((p) => (
    <article class:list={['card pk', { featured: p.tag }, p.tag ? 'glint' : '']} data-reveal>
      {p.tag && <p class="tag">{p.tag}</p>}
      <h3>{p.short}</h3>
      <p class="price"><span class="grad-text">{money(p.price)}</span></p>
      <p class="muted sum">{p.summary}</p>
      <ul class="ticks">{p.includes.map((i) => <li>{i}</li>)}</ul>
      <p class="small muted cover">Warranty covers: {p.warrantyCovers.toLowerCase()}</p>
      <a class:list={['btn', p.tag === 'Most popular' ? 'btn-primary' : 'btn-ghost']} href={`${quoteBase}?package=${p.id}#quote-form`} data-track="quote_start">
        Get this price <Icon name="arrow" />
      </a>
    </article>
  ))}
</div>
<div class="unsure card">
  <div>
    <h3>Not sure which one?</h3>
    <p class="muted">Tell us your car and how you use it. We’ll recommend one, and we’ll tell you if you don’t need the double layer. Add-on: {addOns.map((a) => `${a.name.toLowerCase()} ${money(a.price)}`).join(', ')}.</p>
  </div>
  <a class="btn btn-ghost" href={`${quoteBase}?package=unsure#quote-form`} data-track="quote_start">Recommend one for me</a>
</div>
{showNote && <p class="note small muted">{priceNote} No surprises on the day.</p>}
<style>
  .pk-grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .pk { display: flex; flex-direction: column; padding-top: 34px; }
  .pk.featured { border-color: rgba(56, 200, 255, 0.45); background: linear-gradient(180deg, rgba(31, 91, 255, 0.12), transparent 40%), var(--panel); }
  .tag { position: absolute; top: -12px; left: 24px; margin: 0; padding: 5px 12px; border-radius: 999px; background: var(--grad); color: var(--ink); font: 700 0.72rem/1 var(--font-body); letter-spacing: 0.12em; text-transform: uppercase; }
  h3 { margin-bottom: 6px; }
  .price { font: 800 3.1rem/1 var(--font-display); margin: 4px 0 10px; letter-spacing: 0.01em; }
  .sum { min-height: 3.2em; }
  .ticks { font-size: 0.94rem; flex: 1; align-content: start; }
  .cover { margin-top: auto; }
  .pk .btn { width: 100%; margin-top: 8px; }
  .unsure { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: space-between; }
  .unsure h3 { margin-bottom: 4px; }
  .unsure p { margin: 0; max-width: 70ch; }
  .note { margin-top: 16px; }
</style>
