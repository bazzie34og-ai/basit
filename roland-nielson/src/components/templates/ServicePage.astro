---
// One service page (src/content/services/<slug>.md). Sections follow the SEO brief:
// hero → is this you → story → how it works → what we work on → fit → gap block → price →
// where we meet → related → FAQ → CTA band (from Base).
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import Faq from '../Faq.astro';
import Icon from '../Icon.astro';
import GapBlock from '../GapBlock.astro';
import ScopeBox from '../ScopeBox.astro';
import RecoveryVideo from '../RecoveryVideo.astro';
import YouTubeLite from '../YouTubeLite.astro';
import { site, tel, inPersonAddOn, areaLabel } from '../../config/site';
import { pathOf, type Service, type Area } from '../../lib/content';
import type { AreaPage } from '../../config/site';
import { faqPage, localService, recoveryVideo, youtubeVideo } from '../../lib/schema';
import { isoDate } from '../../lib/blog';

interface Props { entry: Service; services: Service[]; areas: (Area & { info: AreaPage })[]; }
const { entry, services, areas } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const path = pathOf(entry.id);
const crumbs = [{ name: 'Services', path: '/services/' }, { name: d.nav, path }];
const related = d.related.map((r) => ({ ...r, s: services.find((x) => x.id === r.slug) })).filter((r) => r.s);
const myAreas = d.areas.map((slug) => areas.find((a) => a.id === slug)).filter((a): a is Area & { info: AreaPage } => Boolean(a));
const schema = [
  localService({ path, name: `${d.serviceName} in Omaha, NE`, serviceType: d.keyword, description: d.description, priceNote: d.priceNote }),
  faqPage(path, d.faqs),
  ...(d.video === 'recovery' ? [recoveryVideo()] : d.video === 'youtube' ? [youtubeVideo()] : []),
];
const updated = isoDate(d.updated);
const serviceLower = d.serviceName.charAt(0).toLowerCase() + d.serviceName.slice(1);
---
<Base path={path} title={d.seoTitle} description={d.description} crumbs={crumbs} schema={schema} kind="service" dateModified={updated}>
  <PageHero eyebrow={d.eyebrow} title={d.title} lead={d.intro} crumbs={[{ name: 'Home', path: '/' }, ...crumbs]} updated={updated}>
    <div class="btn-row">
      <a class="btn brass" href={site.booking} rel="noopener"><Icon name="calendar" />Book a free 20-minute call</a>
      <a class="btn ghost" href={tel}><Icon name="phone" />Call or text {site.phone.display}</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="you-h">
    <div class="wrap grid-2 top">
      <div>
        <p class="eyebrow">Is this you?</p>
        <h2 id="you-h">“{d.pain.replace(/[.?!]$/, '')}.”</h2>
      </div>
      <ul class="check-list">{d.isThisYou.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section white" aria-labelledby="story-h">
    <div class="wrap narrow prose">
      <h2 id="story-h">{d.storyHeading}</h2>
      <Content />
    </div>
  </section>

  {d.video && (
    <section class="section" aria-labelledby="video-h" data-shared>
      <div class="wrap grid-2">
        <div><p class="eyebrow">Hear it from Roland</p><h2 id="video-h">{d.video === 'recovery' ? 'Rebuilding after addiction: my story' : 'A short message before you call'}</h2></div>
        <div>{d.video === 'recovery' ? <RecoveryVideo /> : <YouTubeLite />}</div>
      </div>
    </section>
  )}

  <section class="section dark grain" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">How {serviceLower} works</h2>
        <p>It starts with a free 20-minute call. After that, every step comes back to three ideas: make tomorrow easier, stop before you react, do what you said.</p>
      </div>
      <ol class={d.steps.length === 3 ? 'steps three' : 'steps'}>
        {d.steps.map((s) => <li><p class="pillar-tag">{s.pillar}</p><h3>{s.h}</h3><p>{s.p}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">What we work on</p><h2 id="work-h">What we actually work on</h2></div>
      <div class="grid-3">{d.workOn.map((w) => <div class="card"><h3>{w.h}</h3><p>{w.p}</p></div>)}</div>
    </div>
  </section>

  <section class="section white" aria-labelledby="fit-h">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Honest fit</p><h2 id="fit-h">Who this is for, and who it's not for</h2></div>
      <div class="grid-2 top">
        <div><h3>A good fit</h3><ul class="check-list">{d.forWho.map((x) => <li>{x}</li>)}</ul></div>
        <div><h3>Not a fit</h3><ul class="x-list">{d.notFor.map((x) => <li>{x}</li>)}</ul></div>
      </div>
      <ScopeBox />
    </div>
  </section>

  <GapBlock />

  <section class="section" aria-labelledby="meet-h">
    <div class="wrap grid-2 top">
      <div data-shared>
        <p class="eyebrow">Price and places</p>
        <h2 id="meet-h">Where we meet, and what it costs</h2>
        <p class="price-line"><strong>{d.priceNote ?? 'Plans from $149/month. No long contracts.'}</strong> <a href="/pricing/">See every plan and price</a>.</p>
        <ul class="check-list">
          <li><strong>In person across Omaha</strong> at your place or a private meeting space, by appointment ({inPersonAddOn.priceLabel} per in-person session).</li>
          <li id="walk-and-talk"><strong>Walk-and-talk</strong> on a trail or around a lake, when the weather allows.</li>
          <li><strong>Video or phone</strong> from anywhere, at no extra cost.</li>
        </ul>
        <p>Evenings and Saturdays. See open times on the <a href={site.booking} rel="noopener">booking page</a>.</p>
      </div>
      <div>
        <h3>{d.nav} near you</h3>
        <ul class="area-links">
          {myAreas.map((a) => <li><a href={pathOf(a.id)}>{serviceLower} in {areaLabel(a.info)}</a></li>)}
          <li><a href="/omaha-life-coach/">Life coaching across the Omaha metro</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section sand" aria-labelledby="related-h">
    <div class="wrap">
      <p class="eyebrow">Related</p>
      <h2 id="related-h">Related coaching</h2>
      <div class="grid-3">
        {related.map((r) => (
          <a class="card" href={pathOf(r.slug)}><h3>{r.anchor}</h3><p>“{r.s!.data.pain}”</p><span class="more">Learn more</span></a>
        ))}
      </div>
      <p class="mt-m"><a class="text-link" href="/">Back to Roland Nielson – Omaha Men's Life Coaching</a></p>
    </div>
  </section>

  <section class="section white" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Questions</p><h2 id="faq-h">{d.nav}: common questions</h2></div>
      <Faq faqs={d.faqs} />
    </div>
  </section>
</Base>
<style>
  .pillar-tag { font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brass-light) !important; font-weight: 700; margin: 0 0 0.4rem; }
  .price-line { font-size: var(--step-1); }
  .area-links { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .area-links li { margin: 0; border-top: 1px solid var(--sand); padding-top: 0.6rem; }
  .area-links a { font-weight: 700; }
</style>
