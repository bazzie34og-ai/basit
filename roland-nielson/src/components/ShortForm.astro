---
import FormHidden from './FormHidden.astro';
interface Props { idPrefix?: string; }
const p = Astro.props.idPrefix ?? 'cta';
---
<form class="form" name="coaching-inquiry" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" data-lead-form>
  <FormHidden type="short" />
  <input type="hidden" name="email" value="" />
  <input type="hidden" name="preferred_contact" value="" />
  <input type="hidden" name="who_for" value="" />
  <input type="hidden" name="session_pref" value="" />
  <input type="hidden" name="best_time" value="" />
  <div class="row two">
    <div class="field">
      <label for={`${p}-name`}>Name</label>
      <input id={`${p}-name`} name="name" autocomplete="name" required aria-describedby={`${p}-name-err`} />
      <p class="error" id={`${p}-name-err`} aria-live="polite"></p>
    </div>
    <div class="field">
      <label for={`${p}-phone`}>Phone</label>
      <input id={`${p}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9\(\)\+\.\s\-]{10,}" aria-describedby={`${p}-phone-err`} />
      <p class="error" id={`${p}-phone-err`} aria-live="polite"></p>
    </div>
  </div>
  <div class="field">
    <label for={`${p}-message`}>What keeps happening?</label>
    <textarea id={`${p}-message`} name="message" rows="3" placeholder="Hey Roland, the thing I keep struggling with is:" aria-describedby={`${p}-message-err`}></textarea>
    <p class="error" id={`${p}-message-err`} aria-live="polite"></p>
  </div>
  <div class="field">
    <label class="consent" data-scope><input type="checkbox" name="consent" value="yes" required aria-describedby={`${p}-consent-err`} /> <span>I understand this is non-clinical coaching, not therapy or crisis support.</span></label>
    <p class="error" id={`${p}-consent-err`} aria-live="polite"></p>
  </div>
  <div><button class="btn brass" type="submit">Send to Roland</button></div>
</form>
