---
// Omaha hub: every service (named exactly like the Google Business Profile services) and every area page.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceArea from '../components/ServiceArea.astro';
import GapBlock from '../components/GapBlock.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { site, tel, inPersonAddOn, areaLabel } from '../config/site';
import { page } from '../data/pages';
import { faqPage, localService } from '../lib/schema';
import { getServices, getAreas, pathOf, serviceGroups } from '../lib/content';

const path = '/omaha-life-coach/';
const meta = page(path);
const services = await getServices();
const areas = await getAreas();

// Hub copy for each service: 2–3 sentences, then a link to its page. Falls back to the page intro.
const blurbs: Record<string, string> = {
  'mens-life-coaching-omaha': "The starting point for most men: one-on-one coaching for the man who feels stuck in the same week. We find what keeps knocking you off track and build a plan you can keep on a bad day.",
  'accountability-coaching': "For men who start strong on Monday and fade by Thursday. You set a few commitments with a bad-day version of each, and every session opens with one question: did you do what you said?",
  'discipline-and-habit-coaching-for-men': "You already know what to do. This is about doing it when you're tired: small habits, a floor you keep no matter what and a plan for the exact moment you usually quit.",
  'stop-before-you-react-coaching': "For the man who snaps at home and regrets it an hour later. We build a pause between the feeling and the words, plus a plan for repairing it when you get it wrong.",
  'confidence-coaching-for-men': "Less second-guessing, more deciding. We work on making a call, owning it and moving on, starting with small decisions so the big ones get easier.",
  'mindset-coaching-for-men': "When your own head is the loudest critic in the room. We catch the stories that keep you stuck and replace them with something you can act on this week.",
  'purpose-and-direction-coaching': "For men on autopilot who lost track of what they're working toward. We get honest about what you want the next few years to look like, then shrink it down to a first step.",
  'relationship-coaching-for-men': "When your marriage feels like two roommates sharing a calendar. Coaching works with you, the man: how you show up, how you listen and how you start the hard talks.",
  'stress-and-overwhelm-coaching-for-men': "Always playing catch-up with work, bills and family. We give the week a shape, cut what doesn't matter and protect a little room to breathe.",
  'coaching-for-fathers': "For dads who are home but not really present. We work on the hour after work, patience with the kids and being the father you wish you'd had.",
  'divorced-dad-coaching': "Starting over and seeing your kids on a schedule. We build a steady routine, a calm way to co-parent and weekends that feel like home for your kids.",
  'life-coaching-for-men-over-40': "Half your life behind you and not where you wanted to be. We take stock without beating yourself up and pick the changes that still matter most.",
  'rebuilding-after-addiction': "Sober, but life is still a mess. Coaching from someone who has lived it adds structure, routine and accountability alongside your meetings, sponsor or recovery program.",
  'life-after-job-loss-coaching': "Laid off and not sure what's next. We steady the daily routine, protect your confidence and turn the job search into something you work on every day without it eating you alive.",
  'in-person-life-coaching-omaha': "Sit across from a real person, or walk side by side. Sessions happen at your place, a private meeting space or on a walk-and-talk around Omaha, by appointment.",
  'online-life-coaching-for-men': "When you can't get across town after work. Video and phone sessions work the same as in person, from home, the office or the truck, at no extra cost.",
  'mentoring-for-men': "For men who never had someone show them how. I share what I learned the hard way, and you decide what fits your life.",
  'the-rebuild-program': "Three to six months of weekly sessions plus check-ins between them, for men who need to rebuild more than one part of life at once.",
};
const byGroup = serviceGroups.map((g) => ({ ...g, items: services.filter((s) => s.data.group === g.id) })).filter((g) => g.items.length);

const pains = [
  { h: "You've been stuck for years", p: 'Same job, same arguments, same promise to start Monday. You want more, and fear keeps you right where you are.' },
  { h: 'You react before you think', p: "A long day lands on your wife and kids. You say things you'd take back, then feel worse than they do." },
  { h: "You're rebuilding after a hard chapter", p: 'Addiction, divorce, a lost job. You want to put life back together the right way this time.' },
  { h: "You're always playing catch-up", p: 'Bills, work, family and everything you said you would do. No structure, so the day runs you.' },
];
const pillars = [
  { h: 'Make tomorrow easier.', p: 'Small choices tonight that set up tomorrow: sleep, a plan, a clean kitchen, the text you have been avoiding.' },
  { h: 'Stop before you react.', p: 'Sit with anger, stress or shame without letting it run the house. Notice it, name it, then choose.' },
  { h: 'Do what you said.', p: 'Keep small promises until keeping your word feels normal again. Trust comes back one kept promise at a time.' },
];
const faqs = [
  { q: 'Who is the best life coach for men in Omaha?', a: "The best life coach for you is the one you'll actually keep showing up for. I'm a men's life coach in Omaha who grew up in North Omaha, rebuilt my own life starting in 2011 and keeps prices out in the open. Take the free 20-minute call, ask hard questions and decide for yourself. No pressure either way." },
  { q: 'Where do in-person sessions happen in Omaha?', a: `In-person sessions happen at your place or a private meeting space in Omaha, set up by appointment. If you'd rather move, we can walk and talk on the Keystone Trail or around Zorinsky Lake. In-person sessions add ${inPersonAddOn.priceLabel} each to cover costs. Video and phone sessions cost nothing extra.` },
  { q: 'Do you coach men in Bellevue, Papillion, Elkhorn or Council Bluffs?', a: 'Yes. My service area covers the whole metro: North Omaha, Midtown, Benson, West Omaha, Elkhorn, Bellevue, Papillion, La Vista, Ralston, Gretna, Bennington and Council Bluffs, Iowa. We can meet in person by appointment, or by video and phone when the drive doesn\'t make sense that week.' },
  { q: 'How much does a life coach cost in Omaha?', a: 'My plans start at $149 a month for two 45-minute sessions. Core Coaching is $249 a month for four sessions, and Focused Support is $399 for four 60-minute sessions. The first three Founding Clients pay $199 a month for three months. The first 20-minute call is free. <a href="/how-much-does-a-life-coach-cost-omaha/">See what coaching costs in Omaha</a>.' },
  { q: 'Is there a life coach near me with evening hours?', a: "Yes. I coach evenings and Saturdays, because most men can't leave work in the afternoon to talk about their life. Sessions can be in person anywhere in the metro, by video after the kids are in bed or by phone on the drive home. You can see open times on the booking page." },
  { q: 'What happens on the free 20-minute call?', a: "You tell me what keeps happening and what you've already tried. I ask a few straight questions. Then I tell you honestly whether I think I can help. If it's a fit, we pick a plan. If not, I'll point you somewhere better. No hard sell. <a href=\"/free-call/\">More about the free call</a>." },
  { q: 'Can my wife or mother book a call for me?', a: 'Yes. A wife, partner, mother or brother can book the free call or reach out first. I will listen, then talk with you directly, because coaching only works when you choose it yourself. What you share with me stays private. <a href="/for-families/">Read the page for families</a>.' },
  { q: 'Can I start online and meet in person later?', a: "Yes. Plenty of men start by video or phone because it's easier to fit in, then meet in person once they know what coaching with me feels like. You can switch back and forth week to week. The plan and the accountability stay the same either way." },
];
const schema = [
  localService({ path, name: "Men's Life Coaching in Omaha, NE", serviceType: 'life coach Omaha', description: meta.description }),
  faqPage(path, faqs),
];
---
<Base path={path} crumbs={[{ name: 'Omaha', path }]} schema={schema} kind="hub" cta={{ heading: 'Tell me what keeps happening.', text: "Book a free 20-minute call, or leave your name and number and I'll reach out. Wherever you are in the metro, we'll find a way to meet.", freeCallLink: true }}>
  <PageHero eyebrow="Life coach in Omaha, NE" title="Life coaching for men across the Omaha metro" lead="Roland Nielson – Omaha Men's Life Coaching is a men's life coach in Omaha, NE who helps men who feel stuck build discipline, keep their word and rebuild their lives. I grew up in North Omaha, and I meet men in person around the metro or by video, evenings and Saturdays, with plans from $149/month." crumbs={[{ name: 'Home', path: '/' }, { name: 'Omaha', path }]} updated={meta.lastmod}>
    <div class="btn-row">
      <a class="btn brass" href={site.booking} rel="noopener"><Icon name="calendar" />Book a free 20-minute call</a>
      <a class="btn ghost" href={tel}><Icon name="phone" />Call or text {site.phone.display}</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="why-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why men in Omaha reach out</p>
        <h2 id="why-h">Why men in Omaha reach out</h2>
        <p>Most men who call me aren't falling apart. They're tired of the same week on repeat.</p>
      </div>
      <div class="grid-2 pains">{pains.map((x) => <div class="card"><h3>{x.h}</h3><p>{x.p}</p></div>)}</div>
    </div>
  </section>

  <section class="section white" aria-labelledby="services-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Coaching services in Omaha</p>
        <h2 id="services-h">Life coaching services for men in Omaha</h2>
        <p>Every service is one-on-one with me, in person in Omaha, on a walk-and-talk, by video or by phone.</p>
      </div>
      {byGroup.map((g) => (
        <div class="svc-group">
          <p class="eyebrow">{g.label}</p>
          <div class="svc-grid">
            {g.items.map((s) => (
              <div class="svc">
                <h2 class="svc-h">{s.data.serviceName}</h2>
                <p>{blurbs[s.id] ?? s.data.intro}</p>
                <a class="text-link" href={pathOf(s.id)}>{s.data.nav} in Omaha</a>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="inperson-h">
    <div class="wrap grid-2 top">
      <div class="prose">
        <p class="eyebrow">In person around Omaha</p>
        <h2 id="inperson-h">How in-person life coaching works in Omaha</h2>
        <p>I don't run a storefront office. I'm a service-area coach, so we meet where it makes sense for you, by appointment: your place if you have a private spot, a private meeting space in Omaha, or a walk-and-talk outdoors when the weather and privacy allow.</p>
        <p>In-person sessions add {inPersonAddOn.priceLabel} each to cover costs. Video and phone sessions work the same way and cost nothing extra, and plenty of men start online and meet in person later. Read more about <a href="/in-person-life-coaching-omaha/">in-person life coaching in Omaha</a> or <a href="/online-life-coaching-for-men/">online life coaching for men</a>.</p>
      </div>
      <div>
        <h3 class="places-h">Walk-and-talk spots</h3>
        <ul class="places">
          <li><strong>Keystone Trail.</strong> Flat and easy, for men who think better while moving.</li>
          <li><strong>Zorinsky Lake.</strong> A loop around the water in west Omaha with room to talk.</li>
          <li><strong>Standing Bear Lake.</strong> Quiet water in northwest Omaha.</li>
          <li><strong>Gene Leahy Mall at The RiverFront.</strong> Downtown, close to the offices.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section sand" aria-labelledby="areas-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Areas I serve</p>
        <h2 id="areas-h">Life coaching across the Omaha metro, area by area</h2>
        <p>Each area has its own page: what men there tell me, where we can meet and local questions.</p>
      </div>
      <ul class="area-grid">
        {areas.map((a) => <li><a href={pathOf(a.id)}><strong>Life coach in {areaLabel(a.info)}</strong><span>{a.data.ogHeadline}</span></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section dark grain" aria-labelledby="pillars-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How I coach</p>
        <h2 id="pillars-h">Three ideas we keep coming back to</h2>
      </div>
      <div class="grid-3">
        {pillars.map((x, i) => <div class="pillar"><span class="num">0{i + 1}</span><h3>{x.h}</h3><p>{x.p}</p></div>)}
      </div>
    </div>
  </section>

  <GapBlock tone="light" />

  <section class="section" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Questions</p><h2 id="faq-h">Life coaching in Omaha: common questions</h2></div>
      <Faq faqs={faqs} />
    </div>
  </section>

  <section class="section white" aria-labelledby="area-h">
    <div class="wrap">
      <ServiceArea embed heading="Map of the Omaha metro I serve" intro="Based in Omaha, NE and serving the whole metro, including Council Bluffs across the river." />
    </div>
  </section>
</Base>
<style>
  .pains .card h3 { font-size: var(--step-1); }
  .svc-group { margin-top: var(--space-m); }
  .svc-grid { display: grid; gap: var(--space-s) var(--space-m); }
  @media (min-width: 720px) { .svc-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .svc-grid { grid-template-columns: repeat(3, 1fr); } }
  .svc { border-top: 1px solid var(--brass); padding-top: 0.9rem; }
  .svc-h { font-size: var(--step-2); margin: 0 0 0.4rem; }
  .svc p { margin: 0 0 0.6rem; }
  .places-h { font-size: var(--step-2); margin-top: 0; }
  .places { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; }
  .places li { margin: 0; border-top: 1px solid var(--brass); padding-top: 0.8rem; }
  .area-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.8rem; }
  @media (min-width: 720px) { .area-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .area-grid { grid-template-columns: repeat(3, 1fr); } }
  .area-grid li { margin: 0; }
  .area-grid a { display: block; height: 100%; background: var(--white); border: 1px solid rgba(14, 27, 44, 0.12); border-radius: var(--radius); padding: 1rem 1.2rem; text-decoration: none; color: var(--charcoal); }
  .area-grid a:hover { border-color: var(--brass); }
  .area-grid strong { display: block; font-family: var(--serif); font-weight: 400; font-size: var(--step-1); color: var(--ink); }
  .area-grid span { font-size: 0.95rem; }
  .pillar { border-top: 1px solid rgba(176, 141, 87, 0.5); padding-top: 1.2rem; }
  .pillar p { color: #b9c2cf; }
</style>
