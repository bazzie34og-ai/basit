---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import YouTubeLite from '../components/YouTubeLite.astro';
import PlanCards from '../components/PlanCards.astro';
import ServiceArea from '../components/ServiceArea.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import heroImg from '../assets/roland-nielson-mens-life-coach-omaha.jpg';
import noteImg from '../assets/rebuilding-after-addiction-coaching-omaha.jpg';
import { site, tel } from '../config/site';
import { homeFaqs, faqs } from '../data/faqs';
import { faqPage, youtubeVideo } from '../lib/schema';

const heroWidths = [360, 520, 671];
const heroSizes = '(min-width: 900px) 440px, 88vw';
const heroAvif = await getImage({ src: heroImg, format: 'avif', widths: heroWidths });
const preload = { srcset: heroAvif.srcSet.attribute, sizes: heroSizes, type: 'image/avif' };
const homeFaqIdx = homeFaqs.map((f, i) => (f.scope ? i : -1)).filter((i) => i >= 0);

const manifesto = ['Keep your word.', 'Call your kids.', 'Clean up your mess.', 'Try again tomorrow.', 'Make tomorrow easier.', 'Stop before you react.', 'Do what you said.'];
const pains = [
  { h: "You've been stuck for years.", p: 'You know you want more. Fear and second-guessing keep you right where you are.' },
  { h: 'Everything hits at once.', p: 'Work, bills, kids, your marriage. You need one simple plan, not ten new apps.' },
  { h: 'You start strong, then slip.', p: 'Monday you are all in. By Thursday the old habits are back. Nobody checks in.' },
  { h: 'You react, then regret it.', p: 'Short fuse at home. You say things you would take back if you could.' },
  { h: "You're home, but not really there.", p: 'Your body is at the table. Your head is still at work or in your phone.' },
  { h: "You're rebuilding after a hard chapter.", p: 'Addiction, divorce, a lost job, a stretch you are not proud of. You want to do it right this time.' },
];
const pillars = [
  { n: '01', h: 'Make tomorrow easier.', p: 'Small choices tonight that set up tomorrow: sleep, a plan, a clean kitchen, a text you have been avoiding.' },
  { n: '02', h: 'Stop before you react.', p: 'Learn to sit with anger, stress or shame without letting it run the house. Notice it, name it, choose.' },
  { n: '03', h: 'Do what you said.', p: 'Keep small promises until keeping your word is normal again. Trust gets rebuilt one kept promise at a time.' },
];
const forWho = [
  { href: '/mens-life-coaching-omaha/', h: 'Men who feel stuck', p: 'Life coaching for men in Omaha who are tired of living the same day.' },
  { href: '/accountability-coaching/', h: 'Men who start strong and slip', p: 'Accountability coaching built for bad days, not just good ones.' },
  { href: '/coaching-for-fathers/', h: 'Fathers and husbands', p: 'Coaching for dads who want to be present, patient and home.' },
  { href: '/rebuilding-after-addiction/', h: 'Men rebuilding after addiction', p: 'Structure, routine and trust from someone who has lived it.' },
  { href: '/the-rebuild-program/', h: 'Men ready for a full reset', p: 'The Rebuild Program: 3–6 months of high-accountability coaching.' },
  { href: '/for-families/', h: 'Worried about him?', p: 'For wives, partners and parents of men who keep getting stuck.' },
];
const steps = [
  { h: 'Free call', p: '20 minutes. Tell me what keeps happening. I tell you honestly if I can help.' },
  { h: 'Plan', p: 'We map your week and pick the two or three things that matter most.' },
  { h: 'Weekly sessions & check-ins', p: 'In person, video or phone. Evenings and Saturdays. You report back, I hold you to it.' },
  { h: 'Real change', p: 'Kept promises stack up. Calmer evenings. A man your family can count on.' },
];
---
<Base path="/" cta={{ freeCallLink: true }} preload={preload} schema={[youtubeVideo(), faqPage('/', homeFaqs)]}>
  <section class="hero dark grain" aria-labelledby="page-h1">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Men's Life Coaching · Omaha, NE</p>
        <h1 id="page-h1">Men's life coaching in Omaha for men ready to rebuild</h1>
        <p class="lead">Plain talk, a simple plan and someone who checks in when it gets hard. For fathers, working men and men starting over.</p>
        <div class="btn-row">
          <a class="btn brass" href={site.booking} rel="noopener"><Icon name="calendar" />Book a Free Discovery Call</a>
          <a class="btn ghost" href={tel}><Icon name="phone" />Call or Text Roland</a>
        </div>
      </div>
      <div class="hero-photo">
        <Picture
          src={heroImg}
          formats={['avif', 'webp']}
          widths={heroWidths}
          sizes={heroSizes}
          alt={'Roland Nielson, men\'s life coach in Omaha, standing beside a wall that reads "Fix it. Change it. Leave it. Or accept it."'}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
    <div class="wrap">
      <ul class="trust" aria-label="At a glance">
        <li><Icon name="clock" />Evenings &amp; Saturdays</li>
        <li><Icon name="pin" />In person, video or phone</li>
        <li><span class="dollar" aria-hidden="true">$</span>Plans from $149/month</li>
        <li><Icon name="calendar" />Free 20-min call</li>
      </ul>
    </div>
  </section>

  <div class="marquee">
    <div class="marquee-track">
      <div class="marquee-set">{manifesto.map((m) => <span>{m}</span>)}</div>
      <div class="marquee-set" aria-hidden="true">{manifesto.map((m) => <span>{m}</span>)}</div>
    </div>
  </div>

  <section class="section" aria-labelledby="pain-h">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Does this sound like you?</p>
        <h2 id="pain-h">You're not lazy. You're tired of living the same day.</h2>
        <p>Most men who call me aren't falling apart. They're holding it together with tape.</p>
      </div>
      <div class="grid-3">
        {pains.map((x) => (
          <div class="card reveal"><h3>{x.h}</h3><p>{x.p}</p></div>
        ))}
      </div>
      <p class="mt-m reveal">If two or more of those hit home, <a href="/mens-life-coaching-omaha/">life coaching for men in Omaha</a> is built for exactly this.</p>
    </div>
  </section>

  <section class="section sand ppa-band" aria-labelledby="ppa-h">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">Free · 5–8 minutes · No call required</p>
        <h2 id="ppa-h">Not ready to talk yet? Start with an honest look.</h2>
        <p class="lead">Answer 20 short statements and see how you handle challenges, people, follow-through and decisions. Your results show up right away.</p>
      </div>
      <div class="reveal ppa-actions">
        <a class="btn" href="/personal-patterns-assessment/">Take the Free Personal Patterns Assessment</a>
        <p class="muted small">Prefer to talk? <a href={site.booking} rel="noopener">Book a free 20-minute discovery call</a> any time.</p>
      </div>
    </div>
  </section>

  <section class="section dark grain" aria-labelledby="pillars-h">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">How I coach</p>
        <h2 id="pillars-h">Three things we keep coming back to</h2>
        <p>"I don't believe one program, meeting, or method works for everybody. We look at your life and use what helps." These three ideas show up every week.</p>
      </div>
      <div class="grid-3">
        {pillars.map((x) => (
          <div class="pillar reveal">
            <span class="num">{x.n}</span>
            <h3>{x.h}</h3>
            <p>{x.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="who-h">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Who it's for</p>
        <h2 id="who-h">Men 30 to 55 with real lives and real pressure</h2>
        <p>Pick the one that sounds closest.</p>
      </div>
      <div class="grid-3">
        {forWho.map((x) => (
          <a class="card reveal" href={x.href}><h3>{x.h}</h3><p>{x.p}</p><span class="more">Learn more</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section sand" aria-labelledby="story-h">
    <div class="wrap grid-2">
      <div class="photo-frame reveal story-photo">
        <Picture src={noteImg} formats={['avif', 'webp']} widths={[360, 540, 720]} sizes="(min-width: 820px) 46vw, 92vw" alt={'Roland Nielson holding a note that reads "Healing isn\'t forgetting. It\'s remembering without bleeding."'} loading="lazy" />
      </div>
      <div class="reveal">
        <p class="eyebrow">My story</p>
        <h2 id="story-h">I grew up in North Omaha. I know what chaos feels like.</h2>
        <p>My mom struggled with meth. My dad wasn't around. I spent time in juvenile detention and carried that chaos into adulthood.</p>
        <p>In 2011 I started changing how I lived. There was no single big moment. I kept showing up. I kept my word more often. I learned to sit with a feeling without letting it run the house.</p>
        <blockquote class="pull">Dad came home. Dad stayed.</blockquote>
        <p class="mt-m">I'm a father of four boys. Being present with them matters more to me than looking like I have it all figured out. That is the kind of man I help other men become.</p>
        <a class="text-link" href="/about/">Read Roland's full story</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="video-h">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">Hear it from me</p>
        <h2 id="video-h">A short message before you call</h2>
        <p class="lead">A short video on who I work with and what coaching with me actually looks like. No sales pitch.</p>
      </div>
      <div class="reveal"><YouTubeLite /></div>
    </div>
  </section>

  <section class="section dark grain" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">Four steps. No mystery.</h2>
      </div>
      <ol class="steps reveal">
        {steps.map((s) => <li><h3>{s.h}</h3><p>{s.p}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="plans-h">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Plans</p>
        <h2 id="plans-h">Clear prices. Pick what fits.</h2>
        <p>A lot of coaches hide their prices until you're on a sales call. I'd rather you know before we talk.</p>
      </div>
      <div class="reveal"><PlanCards showAddOn={false} /></div>
      <p class="mt-m"><a class="text-link" href="/pricing/">See full pricing and what's included</a></p>
    </div>
  </section>

  <Testimonials limit={3} />

  <section class="section white" aria-labelledby="area-h">
    <div class="wrap reveal">
      <ServiceArea heading="Coaching across the Omaha metro" intro="In person by appointment from Bennington to Bellevue and Elkhorn to Council Bluffs. Video and phone from anywhere." />
      <p class="mt-m"><a class="text-link" href="/omaha-life-coach/">How coaching across Omaha works, area by area</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-h">Straight answers</h2>
      </div>
      <Faq faqs={homeFaqs} scopeIndexes={homeFaqIdx} />
      <p class="mt-m"><a class="text-link" href="/faq/">Read all {faqs.length} questions</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--ink); color: #d9dee6; padding: calc(var(--header-h) + var(--space-m)) 0 var(--space-m); position: relative; isolation: isolate; }
  .hero-grid { display: grid; gap: var(--space-m); align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.25fr 0.85fr; } }
  .hero h1 { color: var(--bone); font-size: var(--step-5); max-width: 13em; }
  .hero .lead { color: #c7cfdb; margin-bottom: 1.8rem; }
  .hero-photo { border-radius: var(--radius); overflow: hidden; border: 1px solid rgba(176, 141, 87, 0.4); aspect-ratio: 671 / 770; max-width: 440px; justify-self: center; width: 100%; background: var(--navy); }
  .hero-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .trust { list-style: none; padding: 1.4rem 0 0; margin: var(--space-m) 0 0; border-top: 1px solid rgba(176, 141, 87, 0.3); display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem 1.5rem; }
  @media (min-width: 900px) { .trust { grid-template-columns: repeat(4, auto); justify-content: space-between; } }
  .trust li { margin: 0; display: flex; align-items: center; gap: 0.55rem; font-size: 0.92rem; font-weight: 600; color: var(--bone); }
  .trust :global(svg), .trust .dollar { width: 18px; height: 18px; color: var(--brass); flex: none; }
  .trust .dollar { font-family: var(--serif); font-size: 1.15rem; line-height: 18px; text-align: center; }
  .marquee-set { display: flex; gap: 3rem; padding-right: 3rem; }
  .pillar { border-top: 1px solid rgba(176, 141, 87, 0.5); padding-top: 1.3rem; }
  .pillar p { color: #b9c2cf; }
  .story-photo { aspect-ratio: 720 / 687; }
  .ppa-actions { display: grid; gap: 0.8rem; justify-items: start; }
  .ppa-actions .small { font-size: 0.92rem; margin: 0; }
</style>
