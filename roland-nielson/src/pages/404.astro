---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../config/site';
const links = [
  { href: '/', label: 'Home' },
  { href: '/mens-life-coaching-omaha/', label: "Men's life coaching in Omaha" },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/about/', label: 'About Roland' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];
---
<Base path="/404/" cta={false}>
  <PageHero eyebrow="404" title="That page is not here" lead="It may have moved. Here are the places most people are looking for." />
  <section class="section">
    <div class="wrap narrow">
      <ul class="tag-row">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      <p class="mt-m"><a class="btn brass" href={site.booking} rel="noopener">Book a Free Discovery Call</a></p>
    </div>
  </section>
</Base>
