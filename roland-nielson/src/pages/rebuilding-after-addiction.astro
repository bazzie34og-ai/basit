---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import RecoveryVideo from '../components/RecoveryVideo.astro';
import CrisisBox from '../components/CrisisBox.astro';
import Icon from '../components/Icon.astro';
import noteImg from '../assets/rebuilding-after-addiction-coaching-omaha.jpg';
import { site, tel, hoursText } from '../config/site';
import { page } from '../data/pages';
import { faqPage, service, recoveryVideo } from '../lib/schema';

const path = '/rebuilding-after-addiction/';
const meta = page(path);
const faqs = [
  { q: 'Is a sober coach or recovery coach the same as what you do?', a: "Not exactly. I am a life coach who has lived through addiction and rebuilt, not a certified recovery professional. I help men build structure, routine and accountability for the life they are rebuilding. I do not run a program, provide sober monitoring or replace meetings, a sponsor or professional care. Coaching sits alongside those.", scope: true },
  { q: 'Do I have to be sober to work with you?', a: "You need to be stable enough to make and keep small commitments. If you are actively using and want to stop, the first step is getting the right support, and I can help you find it. If you are early in recovery or a few years in, coaching can help you build the rest of your life around it." },
  { q: 'Will you tell me which recovery path to follow?', a: "No. I don't believe one program, meeting or method works for everybody. Some men do AA or NA, some do SMART Recovery, some lean on faith, family or a professional. We look at your life and use what helps. If something is working for you, we protect it." },
  { q: 'Can coaching help me rebuild trust with my family?', a: "Yes. Trust comes back slowly, through kept promises, not big speeches. We work on what you can control: showing up on time, being honest about small things, calling when you said you would, and owning past damage without making it about you. Your family decides when to trust again. Your job is to be consistent." },
  { q: 'What about life after rehab in Omaha?', a: "Coming home after rehab is often harder than being there. The structure is gone, old people and places are close, and everyone is watching. Coaching helps you rebuild a daily routine, plan for the hardest hours of the week and stay accountable. It works best alongside your aftercare plan, meetings and support network." },
  { q: 'Is it confidential?', a: "Yes. What you share stays between us unless someone is at risk of serious harm or the law requires it. I won't talk to your family, employer or probation officer without your written permission. Coaching is not legally privileged the way some professions are, and I explain that on the free call." },
];
const scopeIdx = [0];
const schema = [
  service({ path, name: 'Life Coaching for Men Rebuilding After Addiction', serviceType: 'Life coaching for men in recovery', description: meta.description }),
  recoveryVideo(),
  faqPage(path, faqs),
];
---
<Base path={path} crumbs={[{ name: 'Rebuilding After Addiction', path }]} schema={schema}>
  <PageHero eyebrow="Rebuilding after addiction · Omaha" title="Life after the hardest chapter" lead="Coaching from someone who has lived addiction, chaos and jail cells, and rebuilt anyway. For men building structure, routine and trust after a hard stretch." crumbs={[{ name: 'Home', path: '/' }, { name: 'Rebuilding After Addiction', path }]} updated={site.contentUpdated}>
    <div class="btn-row">
      <a class="btn brass" href={site.booking} rel="noopener"><Icon name="calendar" />Book a Free Discovery Call</a>
      <a class="btn ghost" href={tel}><Icon name="phone" />Call or Text Roland</a>
    </div>
  </PageHero>

  <section class="section tight" aria-label="Crisis help">
    <div class="wrap narrow"><CrisisBox /></div>
  </section>

  <section class="section" aria-labelledby="story-h">
    <div class="wrap grid-2 top">
      <div class="prose">
        <p class="eyebrow">Why I do this</p>
        <h2 id="story-h">People get quiet when you talk about recovery. I don't.</h2>
        <p>I grew up in North Omaha with a mom who struggled with meth and a dad who wasn't around. I spent time in juvenile detention and carried that chaos into adulthood. I lived addiction. I've sat in jail cells and at funerals.</p>
        <p>In 2011 I started changing how I lived. No single big moment. I kept showing up, kept my word more often, and learned to sit with a feeling without letting it run the house.</p>
        <p>I'm not hiding my story to make anybody comfortable. Addiction doesn't look one way. It looks like real people who decided they wanted better. If that's you, I want to help you build what comes next.</p>
      </div>
      <div><RecoveryVideo /></div>
    </div>
  </section>

  <section class="section white" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we work on</p>
        <h2 id="work-h">Building a life worth staying sober for</h2>
        <p>Getting clean is a beginning. What you build around it is what keeps it.</p>
      </div>
      <div class="grid-3">
        <div class="card"><h3>Daily structure</h3><p>Wake time, meals, work, meetings, sleep. Empty hours are dangerous hours, so we fill them on purpose.</p></div>
        <div class="card"><h3>A plan for the hard hours</h3><p>A plan matters most when you're angry, tired, broke, lonely, or ready to quit. We write it down before you need it.</p></div>
        <div class="card"><h3>Accountability</h3><p>Weekly sessions where you report what you said you'd do. Honest, not harsh.</p></div>
        <div class="card"><h3>Rebuilding trust</h3><p>With your kids, partner, parents and employer. Kept promises, small and often.</p></div>
        <div class="card"><h3>Work and money</h3><p>Getting back to steady work, handling debt and building a little stability you can stand on.</p></div>
        <div class="card"><h3>Who you are now</h3><p>Shame keeps men stuck. We work on owning the past without living in it.</p></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="sessions-h">
    <div class="wrap grid-2 top">
      <div class="photo-frame note-photo">
        <Picture src={noteImg} formats={['avif', 'webp']} widths={[360, 540, 720]} sizes="(min-width: 820px) 45vw, 92vw" alt={'Roland Nielson holding a note that reads "Healing isn\'t forgetting. It\'s remembering without bleeding."'} loading="lazy" />
      </div>
      <div class="prose">
        <p class="eyebrow">How sessions work</p>
        <h2 id="sessions-h">Alongside your support, not instead of it</h2>
        <p>If you have meetings, a sponsor, professional care or an aftercare plan, keep them. Coaching works next to them and focuses on the rest of your week: routines, relationships, work and the goals you've been putting off.</p>
        <ul class="check-list">
          <li>Free 20-minute call first. Be honest about where you are.</li>
          <li>Weekly sessions in person in Omaha, by video or by phone.</li>
          <li>Evenings and Saturdays: {hoursText}.</li>
          <li>Men who want a longer, deeper reset often choose <a href="/the-rebuild-program/">the Rebuild Program</a>.</li>
        </ul>
        <p>Want local meetings and groups too? See my list of <a href="/omaha-resources/">Omaha resources for men</a>.</p>
      </div>
    </div>
  </section>

  <section class="section dark grain" aria-labelledby="change-h">
    <div class="wrap grid-2 top">
      <div>
        <p class="eyebrow">What changes</p>
        <h2 id="change-h">Your story is real. So is your comeback.</h2>
        <p>No promises about outcomes. Recovery is yours. Here's what men rebuilding often notice when they stay with it:</p>
      </div>
      <ul class="check-list">
        <li>Days have a shape, so cravings and boredom have less room.</li>
        <li>You have a written plan for the worst hours of the week.</li>
        <li>Family starts to believe you again, slowly, because you're consistent.</li>
        <li>You stop hiding your story and start using it.</li>
        <li>Goals you'd given up on get back on the calendar.</li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="not-h">
    <div class="wrap grid-2 top" data-scope>
      <div><p class="eyebrow">Plain and clear</p><h2 id="not-h">What this is not</h2></div>
      <div class="prose">
        <p>I'm a non-clinical life coach. I am not a counselor, therapist, doctor or certified peer-recovery specialist. Coaching is not addiction treatment, detox, medication management or crisis care, and it is not a substitute for any of them.</p>
        <p>If you need any of that, I'll help you find it, and coaching can continue alongside it. If you are in danger right now, call 911. For crisis support, call or text 988. For local services, call 211.</p>
      </div>
    </div>
  </section>

  <section class="section white" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Questions</p><h2 id="faq-h">Questions about coaching in recovery</h2></div>
      <Faq faqs={faqs} scopeIndexes={scopeIdx} />
    </div>
  </section>

  <RelatedLinks heading="Related" links={[
    { href: '/blog/rebuilding-trust-after-addiction/', title: 'Rebuilding trust after addiction', text: 'What actually helps, from someone who has been there.' },
    { href: '/accountability-coaching/', title: 'Accountability coaching in Omaha', text: 'Habits, check-ins and a plan built for bad days.' },
    { href: '/for-families/', title: 'For families', text: 'Worried about a husband or son after rehab? Start here.' },
  ]} />
</Base>
<style>
  .note-photo { aspect-ratio: 720 / 687; }
</style>
