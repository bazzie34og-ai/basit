---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import RecoveryVideo from '../components/RecoveryVideo.astro';
import Icon from '../components/Icon.astro';
import { site, tel, rebuildProgram } from '../config/site';
import { page } from '../data/pages';
import { faqPage, service, recoveryVideo, areaServed, ids } from '../lib/schema';
import { abs } from '../config/site';

const path = '/the-rebuild-program/';
const meta = page(path);
const faqs = [
  { q: 'How is the Rebuild Program different from regular coaching?', a: "The Rebuild Program is longer, deeper and more hands-on. Regular plans give you scheduled sessions. The Rebuild Program adds check-ins between sessions, a full plan across habits, mindset, relationships, discipline and long-term goals, and a 3- or 6-month commitment so we have time to do real work instead of patching things week to week." },
  { q: 'How much does the Rebuild Program cost?', a: rebuildProgram.price ? `The Rebuild Program is $${rebuildProgram.price} a month for a 3- or 6-month commitment. We talk through whether it fits on a free call first.` : "Pricing is shared on the free call, because the program is shaped around each man and his commitment length. It costs more than the standard plans because it includes more contact between sessions. You will know the full price before you commit to anything." },
  { q: 'Why do I have to apply?', a: "Because it only works for men who are ready to commit. I keep a small number of Rebuild spots so I can actually be available between sessions. The application is just the free call: we talk, I ask honest questions, and we both decide whether this is the right fit right now." },
  { q: 'What if I need to stop partway through?', a: "Life happens. We talk about the exact terms before you start, including what happens if something serious comes up. My goal is not to trap anybody in a contract. It is to give you a long enough runway that the changes stick." },
  { q: 'Is the Rebuild Program only for men in recovery?', a: "No. It is for any man who wants a full reset: after addiction, divorce, a job loss, a health scare, or just years of drifting. Some of the men who choose it are rebuilding after addiction, and the program works well alongside meetings or professional support." },
];
const schema = [
  service({ path, name: rebuildProgram.name, serviceType: "Men's coaching program", description: meta.description, offerIds: [] }),
  {
    '@type': 'Offer',
    '@id': abs(`${path}#offer`),
    name: rebuildProgram.name,
    description: rebuildProgram.summary,
    offeredBy: { '@id': ids.business },
    areaServed,
    ...(rebuildProgram.price ? { price: rebuildProgram.price, priceCurrency: 'USD' } : {}),
    url: abs(path),
  },
  recoveryVideo(),
  faqPage(path, faqs),
];
const phases = [
  { n: '01', h: 'Stabilize', when: 'First month', p: 'Stop the bleeding. Sleep, routine, money basics and a written plan for the hardest hours of your week. We find what keeps knocking you down and put guardrails around it.' },
  { n: '02', h: 'Rebuild', when: 'Middle months', p: 'Habits, discipline and relationships. Keeping your word to yourself and others. Hard conversations at home. Work and goals you have been putting off. Weekly sessions plus check-ins between them.' },
  { n: '03', h: 'Sustain', when: 'Final stretch', p: 'Make it yours. We test the plan against real life, prepare for setbacks, and set long-term goals so the changes hold after the program ends.' },
];
---
<Base path={path} crumbs={[{ name: 'The Rebuild Program', path }]} schema={schema} cta={{ heading: 'Ready to apply?', text: 'The application is a free 20-minute call. Tell me where you are and where you want to be. If it is a fit, we will plan your start.' }}>
  <PageHero eyebrow="Premium coaching · 3–6 months" title="The Rebuild Program" lead="A 3–6 month, high-accountability program for men who are done patching things and ready to rebuild: habits, mindset, relationships, discipline and long-term goals." crumbs={[{ name: 'Home', path: '/' }, { name: 'The Rebuild Program', path }]} updated={site.contentUpdated}>
    <div class="btn-row">
      <a class="btn brass" href={rebuildProgram.cta.href} rel="noopener"><Icon name="calendar" />{rebuildProgram.cta.label}</a>
      <a class="btn ghost" href={tel}><Icon name="phone" />Call {site.phone.display}</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="who-h">
    <div class="wrap grid-2 top">
      <div class="prose">
        <p class="eyebrow">Who it's for</p>
        <h2 id="who-h">For men who know a weekly chat won't be enough</h2>
        <p>Some men need a steady check-in. Others need a full rebuild. If you're coming out of addiction, a divorce, a lost job or years of drifting, and you're ready to put real effort in for a few months, this is built for you.</p>
        <ul class="check-list">
          <li>You've tried to change on your own and keep ending up back at the start.</li>
          <li>More than one area of life needs work at the same time.</li>
          <li>You want someone in your corner between sessions, not just during them.</li>
          <li>You're willing to commit for 3 or 6 months.</li>
        </ul>
        <p>Not sure if you need the full program? Start with <a href="/accountability-coaching/">accountability coaching</a> or compare <a href="/pricing/">all coaching plans</a>.</p>
      </div>
      <div><RecoveryVideo /></div>
    </div>
  </section>

  <section class="section dark grain" aria-labelledby="phases-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Three phases</p>
        <h2 id="phases-h">Stabilize. Rebuild. Sustain.</h2>
        <p>Every man's timeline is different. This is the shape most programs follow.</p>
      </div>
      <div class="grid-3">
        {phases.map((x) => (
          <div class="phase reveal">
            <span class="num">{x.n}</span>
            <h3>{x.h}</h3>
            <p class="when">{x.when}</p>
            <p>{x.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section white" aria-labelledby="week-h">
    <div class="wrap grid-2 top">
      <div><p class="eyebrow">A typical week</p><h2 id="week-h">What a week in the program looks like</h2></div>
      <div class="prose">
        <p><strong>Session day.</strong> We start with the same question every time: did you do what you said? Then we look at what got in the way, adjust the plan and set the next few commitments. Evenings or Saturday, in person, by video or by phone.</p>
        <p><strong>Midweek check-in.</strong> A short check between sessions, usually around the point in the week where men tend to slip. It's not a lecture. It's a reminder that someone is paying attention, and a chance to fix a bad Tuesday before it becomes a bad month.</p>
        <p><strong>The weekend.</strong> For a lot of men this is the hardest stretch: unstructured time, family pressure, old habits. Your plan covers it on purpose.</p>
        <p>Why 3 to 6 months? Because most of what we're changing took years to build. A few weeks is enough to feel better. A few months is enough to become someone who keeps it going without me.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="inc-h">
    <div class="wrap grid-2 top">
      <div><p class="eyebrow">What's included</p><h2 id="inc-h">More contact. More accountability.</h2></div>
      <div class="prose">
        <ul class="check-list">
          <li><strong>Weekly one-on-one sessions</strong> in person in Omaha, by video or by phone.</li>
          <li><strong>Between-session check-ins</strong> so a bad Tuesday doesn't turn into a bad month.</li>
          <li><strong>A full rebuild plan</strong> covering habits, mindset, relationships, discipline and long-term goals.</li>
          <li><strong>A written plan for your hardest hours,</strong> for when you're angry, tired, broke, lonely, or ready to quit.</li>
          <li><strong>Regular reviews</strong> to look at what's working and change what isn't.</li>
          <li><strong>Evening and Saturday times</strong> that fit around work and family.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section white" aria-labelledby="commit-h">
    <div class="wrap grid-2 top">
      <div>
        <p class="eyebrow">Commitment</p>
        <h2 id="commit-h">3 months or 6 months</h2>
      </div>
      <div class="prose">
        <p><strong>3 months</strong> suits men with one or two big areas to rebuild and a decent foundation to stand on.</p>
        <p><strong>6 months</strong> suits men rebuilding after addiction or a major life change, or anyone who wants time for the new habits to really set.</p>
        <p class="price-line">{rebuildProgram.price ? <>From <strong>${rebuildProgram.price}/month</strong>.</> : <>Pricing is shared on the free call.</>} Spots are limited so I can actually be there between sessions.</p>
        <a class="btn" href={rebuildProgram.cta.href} rel="noopener"><Icon name="calendar" />{rebuildProgram.cta.label}</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Questions</p><h2 id="faq-h">About the Rebuild Program</h2></div>
      <Faq faqs={faqs} />
      <p class="mt-m muted" data-scope>The Rebuild Program is non-clinical coaching. It is not addiction treatment or therapy and does not replace them.</p>
    </div>
  </section>

  <RelatedLinks heading="Related" links={[
    { href: '/rebuilding-after-addiction/', title: 'Rebuilding after addiction', text: "Roland's story and how coaching works alongside recovery." },
    { href: '/pricing/', title: 'Coaching plans and prices', text: 'Monthly plans from $149 and the founding client rate.' },
    { href: '/about/', title: 'About Roland', text: 'Who you would be working with, and why.' },
  ]} />
</Base>
<style>
  .phase { border-top: 1px solid rgba(176, 141, 87, 0.5); padding-top: 1.3rem; }
  .phase p { color: #b9c2cf; }
  .phase .when { font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brass-light); font-weight: 700; margin-bottom: 0.6rem; }
  .price-line { font-size: var(--step-1); }
</style>
