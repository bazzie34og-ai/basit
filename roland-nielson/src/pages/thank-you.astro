---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CrisisBox from '../components/CrisisBox.astro';
import Icon from '../components/Icon.astro';
import { site, tel, whatsapp } from '../config/site';
const wa = whatsapp();
---
<Base path="/thank-you/" cta={false}>
  <PageHero eyebrow="Message received" title="Thanks. I got your message." lead="Roland replies within 24 hours, usually the same evening." />
  <section class="section">
    <div class="wrap narrow prose">
      {wa && (
        <div class="wa-box" data-wa-box hidden>
          <h2>Want Roland to see it right now?</h2>
          <p>Send your message to his WhatsApp. It's already typed out, just tap Send.</p>
          <a class="btn brass" href={wa} rel="noopener" data-wa-send data-wa-base={wa}><Icon name="whatsapp" />Send on WhatsApp</a>
        </div>
      )}
      <h2>What happens next</h2>
      <ol>
        <li><strong>I read every message myself.</strong> No assistants, no auto-replies.</li>
        <li><strong>I'll reach out</strong> the way you asked: call, text or email.</li>
        <li><strong>We set up a free 20-minute call</strong> to talk about what's going on and whether coaching fits.</li>
      </ol>
      <p>Don't want to wait? Grab a time now:</p>
      <div class="btn-row">
        <a class="btn brass" href={site.booking} rel="noopener"><Icon name="calendar" />Book the Free Discovery Call</a>
        <a class="btn ghost" href={tel}><Icon name="phone" />Call {site.phone.display}</a>
      </div>
      <div class="mt-m"><CrisisBox /></div>
      <p class="mt-m">While you wait: <a href="/blog/what-to-do-on-a-bad-tuesday/">what to do on a bad Tuesday</a>.</p>
    </div>
  </section>
</Base>
<script>
  // The form stores a ready-to-send summary (this browser only) before it submits.
  const box = document.querySelector<HTMLElement>('[data-wa-box]');
  const link = document.querySelector<HTMLAnchorElement>('[data-wa-send]');
  let msg = '';
  try { msg = sessionStorage.getItem('rn_wa_message') || ''; } catch { /* storage blocked */ }
  if (box && link && msg) {
    link.href = `${link.dataset.waBase}?text=${encodeURIComponent(msg)}`;
    box.hidden = false;
  }
</script>
<style>
  .wa-box { background: var(--white); border: 1px solid var(--sand); border-radius: var(--radius); padding: var(--space-m); margin-bottom: var(--space-m); }
  .wa-box h2 { margin-top: 0; }
</style>
