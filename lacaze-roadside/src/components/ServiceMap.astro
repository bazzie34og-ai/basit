---
// Illustrative service-area map (no street address). Click loads the interactive Google map.
import Icon from './Icon.astro';
import { b, towns } from '../lib/site.js';
const W = 800, H = 600;
const P = (lat, lng) => [((lng + 95.86) / 0.62) * W, ((30.42 - lat) / 0.58) * H];
const pts = [
  ['Conroe', 30.3119, -95.4561, '/roadside-assistance-conroe-tx/'],
  ['The Woodlands', 30.1658, -95.4613, '/roadside-assistance-the-woodlands-tx/'],
  ['Magnolia', 30.2091, -95.7508, '/roadside-assistance-magnolia-tx/'],
  ['Tomball', 30.0972, -95.6161, '/roadside-assistance-tomball-tx/'],
  ['Klein', 30.028, -95.53, '/roadside-assistance-klein-cypress-tx/'],
  ['Cypress', 29.9691, -95.6972, '/roadside-assistance-klein-cypress-tx/'],
  ['North Houston', 29.944, -95.416, '/roadside-assistance-north-houston/'],
];
const spring = P(30.0799, -95.4172);
const line = (coords) => coords.map(([la, ln], i) => `${i ? 'L' : 'M'}${P(la, ln).map((v) => v.toFixed(1)).join(' ')}`).join('');
const roads = [
  { name: 'I-45', d: line([[29.84, -95.4], [29.94, -95.41], [30.03, -95.43], [30.1, -95.44], [30.17, -95.46], [30.24, -95.46], [30.32, -95.47], [30.43, -95.5]]), w: 4 },
  { name: 'TX-249', d: line([[29.9, -95.49], [29.99, -95.55], [30.05, -95.59], [30.1, -95.62], [30.16, -95.68], [30.21, -95.75]]), w: 3 },
  { name: 'SH 99', d: line([[29.86, -95.74], [29.98, -95.745], [30.06, -95.7], [30.1, -95.64], [30.125, -95.55], [30.105, -95.47], [30.08, -95.38], [30.05, -95.28]]), w: 3 },
  { name: 'FM 1960', d: line([[29.94, -95.66], [29.975, -95.56], [30.0, -95.47], [29.99, -95.39], [29.985, -95.28]]), w: 2 },
];
const lake = line([[30.42, -95.6], [30.39, -95.57], [30.36, -95.56], [30.34, -95.58], [30.36, -95.61], [30.4, -95.63], [30.42, -95.62]]) + 'Z';
const embed = b.googleMapsEmbedUrl || 'https://maps.google.com/maps?q=Spring,+TX+77389&z=10&output=embed';
---
<div class="map" data-src={embed}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-t">
    <title id="map-t">Illustrated map of the LaCaze Roadside Assistance service area around Spring, TX: The Woodlands, Conroe, Magnolia, Tomball, Klein, Cypress and North Houston</title>
    <defs>
      <radialGradient id="cov">
        <stop offset="0" stop-color="#84E23E" stop-opacity=".18" />
        <stop offset=".7" stop-color="#84E23E" stop-opacity=".05" />
        <stop offset="1" stop-color="#84E23E" stop-opacity="0" />
      </radialGradient>
      <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="#1A1F21" stroke-width="1" /></pattern>
    </defs>
    <rect width={W} height={H} fill="#0E1112" />
    <rect width={W} height={H} fill="url(#grid)" />
    <path d={lake} fill="#132026" stroke="#1D3038" />
    <text x={P(30.385, -95.545)[0]} y={P(30.385, -95.545)[1]} fill="#5E6A70" font-size="13" font-family="Inter, sans-serif">Lake Conroe</text>
    <circle cx={spring[0]} cy={spring[1]} r="330" fill="url(#cov)" />
    {roads.map((r) => <path d={r.d} fill="none" stroke="#2F373B" stroke-width={r.w + 4} stroke-linecap="round" stroke-linejoin="round" />)}
    {roads.map((r) => <path d={r.d} fill="none" stroke="#4A5459" stroke-width={r.w} stroke-linecap="round" stroke-linejoin="round" stroke-dasharray={r.name === 'I-45' ? '0' : '0'} />)}
    <path d={roads[0].d} fill="none" stroke="#84E23E" stroke-opacity=".5" stroke-width="1.5" stroke-dasharray="10 10" class="lane-dash" />
    {[['I-45', 30.255, -95.44], ['SH 99', 30.135, -95.6], ['TX-249', 30.0, -95.6], ['FM 1960', 29.965, -95.47]].map(([n, la, ln]) => {
      const [x, y] = P(la, ln);
      return (<g><rect x={x - 26} y={y - 11} width="52" height="20" rx="6" fill="#1C2124" stroke="#2A3034" /><text x={x} y={y + 3.5} fill="#A3ABAF" font-size="11" font-weight="700" font-family="Inter, sans-serif" text-anchor="middle">{n}</text></g>);
    })}
    {pts.map(([name, la, ln]) => {
      const [x, y] = P(la, ln);
      return (<g><circle cx={x} cy={y} r="5" fill="#F4F6F5" /><text x={x + 10} y={y + 5} fill="#F4F6F5" font-size="15" font-weight="700" font-family="Inter, sans-serif">{name}</text></g>);
    })}
    <circle cx={spring[0]} cy={spring[1]} r="18" fill="none" stroke="#84E23E" stroke-opacity=".5" class="headlight" />
    <circle cx={spring[0]} cy={spring[1]} r="8" fill="#84E23E" />
    <text x={spring[0] + 16} y={spring[1] + 6} fill="#84E23E" font-size="18" font-weight="800" font-family="Inter, sans-serif">Spring · home base</text>
  </svg>
  <span class="map__note">Illustration · not to scale</span>
  <button type="button" class="btn btn--ghost map__btn" data-map-load><Icon name="pin" />Open interactive map</button>
</div>
