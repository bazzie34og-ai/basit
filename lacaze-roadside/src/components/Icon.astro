---
// Custom line icons (1.75 stroke, rounded) matching the logo's lane/bolt style.
interface Props { name: string; class?: string; label?: string }
const { name, class: cls, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false" {...a11y}>
  {name === 'battery' && (<>
    <rect x="2.5" y="7" width="17" height="11" rx="2.5" />
    <path d="M19.5 10.5h1.25a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-.75.75H19.5" />
    <path d="M11.6 8.8 8.4 13h3.2l-1.2 3.2 3.4-4.4h-3.2l1-3z" fill="currentColor" stroke-width="1" />
  </>)}
  {name === 'key' && (<>
    <circle cx="7.5" cy="12" r="4.25" />
    <circle cx="7.5" cy="12" r="1.25" />
    <path d="M11.75 12H21.5" />
    <path d="M18 12v3" />
    <path d="M15 12v2.25" />
  </>)}
  {name === 'fuel' && (<>
    <path d="M7 5.5h6.5L17 9v10.5A1.5 1.5 0 0 1 15.5 21h-9A1.5 1.5 0 0 1 5 19.5V7.5a2 2 0 0 1 2-2Z" />
    <path d="M8.5 3h4" />
    <path d="M10.5 3v2.5" />
    <path d="M17 9l2.25-2.25a1 1 0 0 1 1.75.7V12" />
    <path d="M11 11.25s-2.25 2.6-2.25 4a2.25 2.25 0 0 0 4.5 0c0-1.4-2.25-4-2.25-4Z" />
  </>)}
  {name === 'phone' && <path d="M5.2 3.5h3l1.5 4-2 1.3a11 11 0 0 0 5.5 5.5l1.3-2 4 1.5v3a2 2 0 0 1-2 2A15.5 15.5 0 0 1 3.2 5.5a2 2 0 0 1 2-2Z" />}
  {name === 'sms' && (<>
    <path d="M4 5.5h16a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-4.5 3.5V17.5H4A1.5 1.5 0 0 1 2.5 16V7A1.5 1.5 0 0 1 4 5.5Z" />
    <path d="M7.5 11.5h.01M12 11.5h.01M16.5 11.5h.01" stroke-width="2.4" />
  </>)}
  {name === 'pin' && (<>
    <path d="M12 21.5s-7-6.1-7-11.5a7 7 0 0 1 14 0c0 5.4-7 11.5-7 11.5Z" />
    <circle cx="12" cy="10" r="2.5" />
  </>)}
  {name === 'locate' && (<>
    <circle cx="12" cy="12" r="6.5" />
    <circle cx="12" cy="12" r="2" fill="currentColor" />
    <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3" />
  </>)}
  {name === 'clock' && (<>
    <circle cx="12" cy="12" r="9" />
    <path d="M12 7v5l3.25 2" />
  </>)}
  {name === 'check' && <path d="M5 12.5l4.25 4.25L19 7" />}
  {name === 'shield' && (<>
    <path d="M12 2.75 4.5 5.5v6c0 4.6 3.1 8.4 7.5 9.75 4.4-1.35 7.5-5.15 7.5-9.75v-6Z" />
    <path d="M8.75 12l2.25 2.25 4.25-4.5" />
  </>)}
  {name === 'tag' && (<>
    <path d="M3 12.2V4.5A1.5 1.5 0 0 1 4.5 3h7.7l9 9-9.3 9.3Z" />
    <circle cx="8" cy="8" r="1.5" />
  </>)}
  {name === 'user' && (<>
    <circle cx="12" cy="8" r="4" />
    <path d="M4 21a8 8 0 0 1 16 0" />
  </>)}
  {name === 'card-off' && (<>
    <rect x="2.5" y="5.5" width="19" height="13" rx="2" />
    <path d="M2.5 9.5h19" />
    <path d="M4 20 20 4" />
  </>)}
  {name === 'bell' && (<>
    <path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15Z" />
    <path d="M10 20.5a2 2 0 0 0 4 0" />
  </>)}
  {name === 'car' && (<>
    <path d="M5 16.5V12l1.8-4.6A2 2 0 0 1 8.7 6h6.6a2 2 0 0 1 1.9 1.4L19 12v4.5" />
    <path d="M3.5 12h17v4.5h-17z" />
    <circle cx="7.5" cy="16.5" r="1.75" />
    <circle cx="16.5" cy="16.5" r="1.75" />
  </>)}
  {name === 'heart' && <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20Z" />}
  {name === 'road' && (<>
    <path d="M9 3 5 21M15 3l4 18" />
    <path d="M12 4v2.5M12 10.5v3M12 17.5V20" />
  </>)}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h10" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'mail' && (<>
    <rect x="3" y="5.5" width="18" height="13" rx="2" />
    <path d="m3.5 7 8.5 6 8.5-6" />
  </>)}
  {name === 'star' && <path d="M12 3.2l2.6 5.5 6 .7-4.4 4.1 1.2 5.9L12 16.5l-5.4 2.9 1.2-5.9L3.4 9.4l6-.7Z" fill="currentColor" stroke="none" />}
  {name === 'facebook' && <path d="M14 8.5V6.8c0-.8.5-1.3 1.3-1.3H17V2.5h-2.5A4 4 0 0 0 10.5 6.5v2H8v3h2.5v10H14v-10h2.6l.4-3Z" fill="currentColor" stroke="none" />}
  {name === 'instagram' && (<>
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <path d="M17.5 6.5h.01" stroke-width="2.5" />
  </>)}
  {name === 'tiktok' && <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.4 5 4.6" />}
  {name === 'youtube' && (<>
    <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
    <path d="m10 9 5 3-5 3Z" fill="currentColor" />
  </>)}
  {name === 'linkedin' && (<>
    <rect x="3" y="3" width="18" height="18" rx="3" />
    <path d="M7.5 10v6.5M7.5 7.5h.01M11 16.5V10M11 13a2.5 2.5 0 0 1 5 0v3.5" />
  </>)}
  {name === 'google' && (<>
    <path d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3Z" fill="#4285F4" stroke="none" />
    <path d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z" fill="#34A853" stroke="none" />
    <path d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1A10 10 0 0 0 2 12c0 1.6.4 3.1 1.1 4.6Z" fill="#FBBC05" stroke="none" />
    <path d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.4L6.4 10C7.2 7.7 9.4 5.9 12 5.9Z" fill="#EA4335" stroke="none" />
  </>)}
</svg>
