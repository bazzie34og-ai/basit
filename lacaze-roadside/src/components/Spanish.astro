---
import Icon from './Icon.astro';
import { tel } from '../lib/site.js';
---
<section class="section section--tight" aria-label="Asistencia en español">
  <div class="wrap">
    <div class="es reveal" lang="es">
      <div>
        <p class="eyebrow">En español</p>
        <p>Asistencia en carretera 24/7 en Spring y el norte de Houston — pasar corriente, abrir su carro, entrega de gasolina. Llame al (832) 949-4837.</p>
      </div>
      <a class="btn btn--primary btn--lg" href={tel} data-track="call"><Icon name="phone" />Llame ahora</a>
    </div>
  </div>
</section>
