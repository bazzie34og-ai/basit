---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { biz, tel, whatsapp } from '../lib/site';
---
<Layout title="Thank you | Paws 2 Purrs" description="Thanks for your enquiry. Vanessa will be in touch soon." path="/thank-you/" noindex>
  <section class="section bg-cream grain thanks">
    <div class="wrap thanks-grid">
      <div>
        <p class="label">Enquiry sent</p>
        <h1>Thank you<span data-thanks-name></span>! <em>Woof.</em></h1>
        <p class="lede">Vanessa will be in touch soon, usually the same day. Can't wait? Call or WhatsApp {biz.phone.display}.</p>
        <div class="btn-row">
          <a class="btn btn--honey btn--lg" href={tel} data-track="call_click"><Icon name="phone" />Call {biz.phone.display}</a>
          <a class="btn btn--outline btn--wa btn--lg" href={whatsapp()} target="_blank" rel="noopener" data-track="whatsapp_click"><span class="wa-ring"><Icon name="whatsapp" /></span>WhatsApp Vanessa</a>
        </div>
        <div class="wa-summary" data-wa-summary-box hidden>
          <h2>Send this to Vanessa on WhatsApp too</h2>
          <p>Want to make doubly sure? Here's a neat summary of your answers, ready to send.</p>
          <pre data-wa-preview></pre>
          <a class="btn btn--pine btn--block" href={whatsapp()} data-number={biz.whatsappNumber} data-wa-summary target="_blank" rel="noopener" data-track="whatsapp_click"><Icon name="whatsapp" />Send summary on WhatsApp</a>
        </div>
        <p class="mt-2"><a class="text-link" href="/">Back to the home page <Icon name="arrow" /></a></p>
      </div>
      <figure class="polaroid thanks-pic" style="--tilt:3deg">
        <Photo name="brindleSmile" eager sizes="(min-width: 900px) 340px, 70vw" />
        <figcaption>This is how happy we are to hear from you.</figcaption>
      </figure>
    </div>
  </section>
</Layout>
<style>
  .thanks-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .thanks-grid { grid-template-columns: 1.2fr 0.8fr; } }
  .thanks-pic { width: min(340px, 80%); margin-inline: auto; }
  .wa-summary { margin-top: 32px; padding: 24px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .wa-summary h2 { font-size: 1.4rem; }
  .wa-summary pre { white-space: pre-wrap; font-family: var(--sans); font-size: 0.9rem; background: var(--cream); border-radius: 12px; padding: 14px; color: #3b413a; }
</style>
