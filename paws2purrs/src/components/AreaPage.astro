---
// Shared frame for area pages. The body copy is passed in per area and must be unique.
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import ServiceLinks from './ServiceLinks.astro';
import Reviews from './Reviews.astro';
import CtaBlock from './CtaBlock.astro';
import AreaMap from './AreaMap.astro';
import { byIds } from '../data/reviews';
import { areaPages, type PhotoKey } from '../lib/site';
import { breadcrumbSchema, serviceSchema } from '../lib/schema';
interface Props {
  area: string; path: string; title: string; h1: string; description: string; lede: string;
  photo: PhotoKey; reviewIds: string[]; waService?: string;
}
const { area, path, title, h1, description, lede, photo, reviewIds, waService = 'daycare or boarding' } = Astro.props;
const trail = [{ name: `Areas: ${area}`, path }];
const others = areaPages.filter((a) => a.href !== path);
---
<Layout
  title={title}
  description={description}
  path={path}
  waService={waService}
  preloadPhoto={photo}
  schema={[serviceSchema(`Dog daycare and boarding for ${area}`, description, path, 'Dog daycare and home boarding'), breadcrumbSchema(trail)]}
>
  <PageHero label={`Near ${area} · from Arnold NG5`} title={h1} lede={lede} photo={photo} trail={trail} waService={waService}
    facts={[{ icon: 'pin', text: 'Based in Arnold, NG5' }, { icon: 'shield', text: 'Licensed & insured' }, { icon: 'camera', text: 'Photo updates' }]} />

  <section class="section section--tight bg-cream">
    <div class="wrap split">
      <div class="prose">
        <slot />
        <p class="small muted">Vanessa is confirming exactly which streets she covers. If you're not sure, just ask.</p>
      </div>
      <div class="split__aside">
        <div class="aside-card">
          <h3>Services for {area}</h3>
          <ServiceLinks area={area} />
        </div>
        <div class="mt-2"><AreaMap /></div>
      </div>
    </div>
  </section>

  <section class="section bg-linen grain" aria-labelledby="area-reviews">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label">Letters from owners</p>
        <h2 id="area-reviews">What local owners <em>say</em></h2>
      </div>
      <Reviews items={byIds(reviewIds)} />
      <p class="center small">Also covering: {others.map((o, i) => <><a href={o.href}>{o.anchor}</a>{i < others.length - 1 ? ' · ' : ''}</>)} · <a href="/dog-daycare-arnold-nottingham/">dog daycare in Arnold</a></p>
    </div>
  </section>

  <CtaBlock waService={waService} />
</Layout>
