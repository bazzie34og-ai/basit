---
import Icon from './Icon.astro';
import { biz } from '../lib/site';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const items = [
  { icon: 'shield', title: `Licensed by ${biz.licence.authority}`, sub: biz.flags.fiveStarLicence ? `${biz.licence.starRating}-star licence` : 'Arnold, Gedling borough' },
  { icon: 'umbrella', title: 'Fully insured', sub: `${biz.experienceYears} years' experience` },
  { icon: 'camera', title: 'Daily photo updates', sub: 'Photos and videos of their day' },
  { icon: 'heart', title: '100% recommended on Facebook', sub: `${biz.facebook.reviewCount} reviews` },
];
---
<section class:list={['trust', { 'trust--compact': compact }]} aria-label="Why you can trust Paws 2 Purrs">
  <ul class="wrap trust-list">
    {items.map((i) => (
      <li>
        <span class="trust-icon"><Icon name={i.icon} /></span>
        <span><strong>{i.title}</strong><small>{i.sub}</small></span>
      </li>
    ))}
  </ul>
</section>

<style>
  .trust { background: var(--paper); border-block: 1px solid var(--line); }
  .trust-list { list-style: none; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 0; padding-block: 6px; }
  .trust-list li { display: flex; align-items: center; gap: 12px; padding: 16px 10px; }
  .trust-list li + li { border-left: 1px solid var(--line); }
  .trust-list li:nth-child(3) { border-left: 0; }
  @media (max-width: 899px) { .trust-list li:nth-child(n + 3) { border-top: 1px solid var(--line); } }
  @media (min-width: 900px) {
    .trust-list { grid-template-columns: repeat(4, 1fr); padding-block: 10px; }
    .trust-list li { padding: 18px 22px; }
    .trust-list li:nth-child(3) { border-left: 1px solid var(--line); }
  }
  .trust-icon { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--moss-soft); color: var(--pine); }
  .trust-icon :global(svg) { width: 22px; height: 22px; }
  .trust-list strong { display: block; font-size: 0.93rem; line-height: 1.3; color: var(--pine); }
  .trust-list small { display: block; font-size: 0.8rem; color: var(--muted); margin-top: 2px; }
  @media (max-width: 420px) {
    .trust-list li { flex-direction: column; align-items: flex-start; gap: 8px; padding: 14px 10px; }
    .trust-icon { width: 38px; height: 38px; }
  }
</style>
