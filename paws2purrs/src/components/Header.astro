---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { biz, nav, tel, whatsapp, licenceLine } from '../lib/site';
interface Props { waService: string; path: string }
const { waService, path } = Astro.props;
---
<header class="site-header" data-header>
  <div class="header-inner">
    <a href="/" class="brand">
      <Logo class="brand-logo" />
    </a>
    <nav class="main-nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <span class="pill pill--moss header-pill"><span class="pulse-dot" aria-hidden="true"></span>{biz.availabilityPill}</span>
      <a class="btn btn--honey header-call" href={tel} data-track="call_click" aria-label={`Call Vanessa on ${biz.phone.display}`}>
        <Icon name="phone" />
        <span class="header-call__short">Call</span>
        <span class="header-call__num">{biz.phone.display}</span>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-sheet" data-menu-open>
        <Icon name="menu" />
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>
</header>

<div class="menu-sheet" id="menu-sheet" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="menu-sheet__top">
    <Logo class="brand-logo" />
    <button class="menu-btn menu-btn--close" type="button" data-menu-close>
      <Icon name="close" /><span class="sr-only">Close menu</span>
    </button>
  </div>
  <p class="pill pill--moss menu-sheet__pill"><span class="pulse-dot" aria-hidden="true"></span>{biz.availabilityPill} · {biz.diaryPill}</p>
  <nav aria-label="Mobile">
    <ul class="menu-sheet__links">
      <li><a href="/">Home</a></li>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      <li><a href="/gallery/">Gallery</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
  </nav>
  <div class="menu-sheet__cta">
    <a class="btn btn--honey btn--lg btn--block" href={tel} data-track="call_click"><Icon name="phone" />Call {biz.phone.display}</a>
    <a class="btn btn--outline btn--wa btn--lg btn--block" href={whatsapp(waService)} target="_blank" rel="noopener" data-track="whatsapp_click">
      <span class="wa-ring"><Icon name="whatsapp" /></span>WhatsApp Vanessa
    </a>
  </div>
  <p class="menu-sheet__foot">{licenceLine}</p>
</div>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 60;
    background: rgba(247, 242, 232, 0.86);
    -webkit-backdrop-filter: saturate(1.4) blur(14px); backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s, background-color 0.3s;
  }
  .site-header.is-scrolled { border-color: var(--line); box-shadow: 0 6px 24px -14px rgba(60, 40, 20, 0.3); background: rgba(247, 242, 232, 0.94); }
  .header-inner {
    max-width: 1360px; margin-inline: auto; padding-inline: var(--gutter);
    display: flex; align-items: center; gap: 20px; height: var(--header-h);
    transition: height 0.3s var(--ease);
  }
  .is-scrolled .header-inner { height: calc(var(--header-h) - 12px); }
  .brand { display: block; flex: none; }
  .brand :global(.brand-logo) { width: 178px; height: auto; transition: width 0.3s var(--ease); }
  .is-scrolled .brand :global(.brand-logo) { width: 160px; }
  .main-nav { display: none; margin-inline: auto; }
  .main-nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .main-nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 999px;
    text-decoration: none; color: var(--pine); font-weight: 600; font-size: 0.94rem; position: relative;
  }
  .main-nav a::after {
    content: ''; position: absolute; left: 12px; right: 12px; bottom: 8px; height: 1.5px; background: var(--honey);
    transform: scaleX(0); transform-origin: left; transition: transform 0.3s var(--ease);
  }
  .main-nav a:hover::after, .main-nav a[aria-current]::after { transform: scaleX(1); }
  .header-actions { display: flex; align-items: center; gap: 10px; margin-left: auto; }
  .header-pill { display: none; }
  .header-call { min-height: 48px; padding: 0 1.1em; }
  .header-call__num { display: none; }
  .menu-btn {
    display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    background: transparent; border: 1.5px solid var(--line); color: var(--pine); cursor: pointer;
  }
  .menu-btn:hover { border-color: var(--pine); }
  .menu-btn :global(svg) { width: 22px; height: 22px; }

  @media (max-width: 420px) {
    .brand :global(.brand-logo) { width: 156px; }
    .header-call { width: 48px; padding: 0; }
    .header-call__short { display: none; }
  }
  @media (min-width: 1080px) {
    .main-nav { display: block; }
    .menu-btn { display: none; }
    .header-actions { margin-left: 0; }
    .header-call__short { display: none; }
    .header-call__num { display: inline; }
  }
  @media (min-width: 1300px) {
    .header-pill { display: inline-flex; }
    .brand :global(.brand-logo) { width: 196px; }
  }

  .menu-sheet {
    position: fixed; inset: 0; z-index: 120; background: var(--cream);
    display: flex; flex-direction: column; padding: 14px var(--gutter) calc(24px + env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
  }
  .menu-sheet[hidden] { display: none; }
  .menu-sheet.is-open { animation: sheet-in 0.35s var(--ease); }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(12px); } }
  .menu-sheet__top { display: flex; align-items: center; justify-content: space-between; min-height: 50px; }
  .menu-sheet__top :global(.brand-logo) { width: 156px; }
  .menu-sheet__pill { margin: 18px 0 6px; align-self: flex-start; }
  .menu-sheet__links { list-style: none; padding: 0; margin: 8px 0 20px; }
  .menu-sheet__links a {
    display: flex; align-items: center; min-height: 56px; border-bottom: 1px solid var(--line);
    font-family: var(--serif); font-size: 1.55rem; font-weight: 500; color: var(--pine); text-decoration: none;
  }
  .menu-sheet__cta { display: grid; gap: 10px; margin-top: auto; }
  .menu-sheet__foot { text-align: center; color: var(--muted); font-size: 0.85rem; margin: 14px 0 0; }
</style>
