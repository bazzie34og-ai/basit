---
// Area page -> every service page, with descriptive anchors.
import Icon from './Icon.astro';
interface Props { area: string }
const { area } = Astro.props;
const links = [
  { href: '/dog-daycare-arnold-nottingham/', icon: 'tree', text: `Doggy daycare for ${area} dogs`, sub: 'Woodland adventures, around 7:30am to 5pm' },
  { href: '/dog-boarding-arnold-nottingham/', icon: 'sofa', text: `Home dog boarding near ${area}`, sub: 'A home from home, not kennels' },
  { href: '/dog-walking-arnold-nottingham/', icon: 'car', text: `Dog walking with pick-up near ${area}`, sub: 'Plus dog pop-ins' },
  { href: '/cat-sitting-arnold-nottingham/', icon: 'cat', text: `Cat sitting & pop-ins near ${area}`, sub: 'And small animal feeds' },
  { href: '/christmas-dog-boarding-nottingham/', icon: 'gift', text: 'Christmas dog boarding', sub: 'Limited spaces, ask early' },
];
---
<ul class="svc-links">
  {links.map((l) => (
    <li><a href={l.href}><span class="svc-links__icon"><Icon name={l.icon} /></span><span><strong>{l.text}</strong><small>{l.sub}</small></span><Icon name="arrow" class="svc-links__arrow" /></a></li>
  ))}
</ul>
<style>
  .svc-links { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 10px; }
  .svc-links a {
    display: flex; align-items: center; gap: 14px; padding: 14px 16px; min-height: 68px; border-radius: var(--r);
    background: var(--paper); border: 1px solid var(--line); text-decoration: none; color: var(--ink);
    transition: transform 0.25s var(--ease), border-color 0.2s, box-shadow 0.25s;
  }
  .svc-links a:hover { transform: translateY(-2px); border-color: var(--moss); box-shadow: var(--shadow-sm); color: var(--ink); }
  .svc-links__icon { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--moss-soft); color: var(--pine); }
  .svc-links__icon :global(svg) { width: 20px; height: 20px; }
  .svc-links strong { display: block; color: var(--pine); line-height: 1.3; }
  .svc-links small { display: block; color: var(--muted); font-size: 0.85rem; }
  .svc-links :global(.svc-links__arrow) { width: 18px; height: 18px; margin-left: auto; flex: none; color: var(--moss); }
</style>
