# ── Site ─────────────────────────────────────────────────────────────
# true (default) = preview: noindex on every page, robots.txt disallows all,
# and the "Preview built for LM Auto Care by Primo Partners" ribbon shows.
PREVIEW_MODE=true
# The live domain, no trailing slash. Drives canonicals, sitemap, schema and OG URLs.
# On Netlify, if unset, the site's own URL is used.
SITE_URL=https://lm-auto-care-preview.netlify.app

# ── Booking emails (Resend: https://resend.com) ──────────────────────
RESEND_API_KEY=
# Preview: Primo Partners. Go-live: lmautocarez@gmail.com (comma-separate for several)
BOOKING_TO_EMAIL=itsprimopartners@gmail.com
# Until a sending domain is verified in Resend, this must stay onboarding@resend.dev.
# Note: onboarding@resend.dev can only send to the Resend account owner's own address,
# so customer auto-replies only work once a domain is verified.
BOOKING_FROM_EMAIL=onboarding@resend.dev

# ── Optional instant alert (Discord, Slack or Google Chat incoming webhook) ──
NOTIFY_WEBHOOK_URL=

# ── Optional Cloudflare Turnstile (spam check on the booking form) ───
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ── Bookings CSV export: /api/bookings.csv (HTTP Basic Auth) ─────────
ADMIN_USER=
ADMIN_PASS=

# ── Analytics (optional). GA4 loads only if set AND the visitor consents. ──
PUBLIC_GA4_ID=
