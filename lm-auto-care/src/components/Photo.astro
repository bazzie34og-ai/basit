---
/**
 * A real LM photo, printed at an honest size. Source files are ~720px phone
 * shots, so widths never exceed the original (no upscaling).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, caption, sizes = '(min-width: 900px) 560px, 92vw', eager = false, class: cls } = Astro.props;
const widths = [360, 540, src.width].filter((w, i, a) => w <= src.width && a.indexOf(w) === i);
---
<figure class:list={['photo', cls]}>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding={eager ? 'sync' : 'async'}
  />
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>
<style>
  .photo {
    margin: 0;
  }
  .photo :global(img) {
    width: 100%;
    height: auto;
    background: var(--paper-2);
  }
  figcaption {
    margin-top: 0.55rem;
    font-size: 0.68rem;
    color: var(--stone-ink);
    max-width: 42ch;
  }
  :global(.on-dark) figcaption {
    color: var(--stone);
  }
</style>
