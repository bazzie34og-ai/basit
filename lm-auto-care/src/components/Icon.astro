---
/** Small hand-made glyphs. Kept to the three the site actually needs. */
interface Props { name: 'whatsapp' | 'phone' | 'arrow' | 'form'; }
const { name } = Astro.props;
---
{name === 'whatsapp' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4.2 19.8l1.1-3.6A8.4 8.4 0 1 1 8 18.9z" />
    <path d="M9.2 8.3c-.3 1.6.5 3.5 1.9 4.9s3.2 2.2 4.8 1.9l.6-1.5-2-.9-.9.9c-.9-.4-1.9-1.4-2.3-2.3l.9-.9-.9-2z" fill="currentColor" stroke-width="0.8" />
  </svg>
)}
{name === 'phone' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6.6 3.5h2.6l1.4 4-2 1.3a10.7 10.7 0 0 0 6.6 6.6l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.3 16.3 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z" />
  </svg>
)}
{name === 'arrow' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 12.4c5.8-.5 11.6-.3 17 .1M14.6 6.5c2 2.1 3.9 4 5.6 6-1.9 1.8-3.8 3.6-5.4 5.6" />
  </svg>
)}
{name === 'form' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 3.5h12v17H6zM9 8h6M9 12h6M9 16h3" />
  </svg>
)}
