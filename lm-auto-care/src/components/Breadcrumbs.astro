---
interface Props { items: { name: string; href: string }[]; }
const { items } = Astro.props;
---
<nav class="crumbs wrap" aria-label="Breadcrumb">
  <ol class="mono">
    {items.map((it, i) => (
      <li>
        {i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { padding-top: 1.1rem; }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.7rem;
    color: var(--stone-ink);
  }
  li + li::before {
    content: '/';
    margin: 0 0.55em;
    color: var(--paper-3);
  }
  a { color: var(--stone-ink); text-decoration: none; border-bottom: 1px solid var(--paper-3); }
  a:hover { color: var(--lm-blue-ink); }
  [aria-current] { color: var(--ink); }
</style>
