---
/**
 * A hand-ticked box mark. Draws itself once when its parent [data-draw]
 * scrolls into view (see scripts/ui.ts). Without JS, or with reduced
 * motion, it is simply there.
 */
interface Props { i?: number; variant?: number; }
const { i = 0, variant = i % 3 } = Astro.props;
const paths = [
  'M3.5 13.2c2.4 1.5 4.3 3.8 6 6.6 3.2-7.4 7.7-12.7 12.9-16.6',
  'M3 12.4c2.1 2 3.9 4.2 5.5 7.2C12 11.7 16.4 6.6 22.6 3.8',
  'M4 14c1.8 1.1 3.6 3 5.2 5.4 2.6-6.1 7-11.6 13-15.9',
];
---
<svg class="tick" viewBox="0 0 26 24" aria-hidden="true" style={`--i:${i}`}>
  <path d={paths[variant]} pathLength="1" />
</svg>
<style>
  .tick {
    width: 1.15em;
    height: 1.1em;
    flex: none;
    overflow: visible;
  }
  .tick path {
    fill: none;
    stroke: var(--tick);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    :global([data-draw]) .tick path {
      stroke-dashoffset: 1;
    }
    :global([data-draw].is-drawn) .tick path {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.38s cubic-bezier(0.6, 0, 0.3, 1);
      transition-delay: calc(var(--i, 0) * 70ms + 120ms);
    }
  }
</style>
