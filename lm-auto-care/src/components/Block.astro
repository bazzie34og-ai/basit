---
/**
 * An editorial section for long-form pages. Variants change the grid so pages
 * don't fall into one rhythm: photo bleeding off an edge with a narrow text
 * column, a narrow centred column, or a dark band.
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
interface Props {
  kicker?: string;
  heading: string;
  id?: string;
  photo?: ImageMetadata;
  alt?: string;
  caption?: string;
  side?: 'left' | 'right';
  variant?: 'photo' | 'narrow' | 'dark' | 'offset';
}
const { kicker, heading, id, photo, alt = '', caption, side = 'right', variant = photo ? 'photo' : 'narrow' } = Astro.props;
const hid = id ?? heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<section class:list={['block', variant, side, { 'on-dark': variant === 'dark', speckle: variant !== 'dark' }]} aria-labelledby={hid}>
  <div class="grid">
    <div class="text">
      {kicker && <p class="mono kicker">{kicker}</p>}
      <h2 id={hid}>{heading}</h2>
      <div class="body prose"><slot /></div>
    </div>
    {photo && (
      <div class="pic">
        <Photo src={photo} alt={alt} caption={caption} sizes="(min-width: 960px) 520px, 100vw" />
      </div>
    )}
  </div>
</section>
<style>
  .block { padding: clamp(3.5rem, 8vw, 6rem) 0; }
  .grid {
    width: min(100% - 2 * var(--gutter), 1240px);
    margin-inline: auto;
    display: grid;
    gap: 2.5rem;
  }
  .kicker { color: var(--lm-blue-ink); margin: 0 0 0.7rem; }
  .dark .kicker { color: var(--lm-blue); }
  h2 { font-size: clamp(1.9rem, 4.6vw, 3rem); margin-bottom: 1.2rem; max-width: 18ch; }
  .narrow .grid { width: min(100% - 2 * var(--gutter), 720px); }
  .narrow h2 { font-style: italic; }
  .dark .grid { width: min(100% - 2 * var(--gutter), 980px); }
  .dark :global(.prose) { color: #dedcd6; }
  .offset .grid { width: min(100% - 2 * var(--gutter), 1100px); }
  @media (min-width: 900px) {
    .offset .text { margin-left: 22%; }
    .offset h2 { font-size: clamp(2.4rem, 5vw, 3.8rem); max-width: 16ch; margin-left: -22%; font-style: italic; }
  }
  @media (min-width: 960px) {
    .photo .grid {
      width: 100%;
      max-width: none;
      grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
      gap: 4.5rem;
      align-items: center;
    }
    .photo .text { padding-left: max(var(--gutter), calc((100vw - 1240px) / 2)); }
    .photo.left .grid { grid-template-columns: minmax(0, 520px) minmax(0, 1fr); }
    .photo.left .pic { order: -1; }
    .photo.left .text { padding-left: 0; padding-right: max(var(--gutter), calc((100vw - 1240px) / 2)); }
    .photo.left :global(figcaption) { margin-left: var(--gutter); }
  }
  @media (max-width: 959px) {
    .photo .pic { margin-inline: calc(-1 * var(--gutter)); }
    .photo :global(figcaption) { padding: 0 var(--gutter); }
  }
</style>
