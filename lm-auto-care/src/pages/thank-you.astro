---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Stamp from '../components/Stamp.astro';
import Honest from '../components/Honest.astro';
import { business, social, waLink, waMessages, giveawaysLine, expectations } from '../config/site.ts';
import { meta } from '../config/pages.ts';
const m = meta('/thank-you/');
---
<Base title={m.title} description={m.description} path="/thank-you/" noindex waText={waMessages.thanks}>
  <section class="ty">
    <p class="mono k">Booking received</p>
    <h1>Got it. Thanks.</h1>
    <Stamp line="Booking request" />
    <ol class="next">
      <li><span class="mono">01</span><p>Your details have come through to us. If you gave an email address, a copy is on its way to you.</p></li>
      <li><span class="mono">02</span><p>We'll message you on WhatsApp to confirm the price and a time. {expectations.replyTime}</p></li>
      <li><span class="mono">03</span><p>On the day, we'll need a water supply and a power socket where the car is.</p></li>
    </ol>
    <Honest />
    <div class="urgent">
      <p>If it's urgent, don't wait for us:</p>
      <div class="btn-row">
        <a class="btn" href={waLink(waMessages.thanks)} data-track="whatsapp_click" rel="noopener"><Icon name="whatsapp" /> WhatsApp us now</a>
        <a class="btn btn--line" href={business.tel} data-track="call_click"><Icon name="phone" /> {business.phoneDisplay}</a>
      </div>
    </div>
    <div class="follow">
      <p>While you wait: see what we've been up to on <a href={social.instagram.url} rel="noopener">Instagram</a> and <a href={social.facebook.url} rel="noopener">Facebook</a>. {giveawaysLine}</p>
      {social.googleReviewUrl && <a class="btn btn--line" href={social.googleReviewUrl} rel="noopener">Leave a Google review</a>}
    </div>
  </section>
</Base>
<style>
  .ty { width: min(100% - 2 * var(--gutter), 760px); margin: 2.5rem auto 5rem; }
  .k { color: var(--lm-blue-ink); margin: 0 0 1rem; }
  h1 { font-size: clamp(3rem, 10vw, 6rem); font-style: italic; line-height: 0.9; margin-bottom: 1.5rem; }
  .next { list-style: none; padding: 0; margin: 2rem 0 1.4rem; border-top: 1.5px solid var(--ink); }
  .next li { display: grid; grid-template-columns: 3rem 1fr; padding: 1rem 0; border-bottom: 1px solid var(--paper-3); }
  .next span { color: var(--lm-blue-ink); padding-top: 0.3rem; }
  .next p { margin: 0; }
  .ty :global(.honest-compact) { color: var(--ink-2); }
  .urgent { margin-top: 2.5rem; }
  .follow { margin-top: 2.5rem; padding-top: 1.4rem; border-top: 1px solid var(--paper-3); font-style: italic; }
</style>
