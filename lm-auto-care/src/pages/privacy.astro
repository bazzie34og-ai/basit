---
import Base from '../layouts/Base.astro';
import { business } from '../config/site.ts';
import { meta } from '../config/pages.ts';
const m = meta('/privacy/');
---
<Base title={m.title} description={m.description} path="/privacy/" breadcrumbs={[{ name: 'Privacy', href: '/privacy/' }]}>
  <section class="pv prose">
    <h1>Privacy</h1>
    <p>This is the plain version. {business.name} is a small mobile valeting business in Aberdeen. We only collect what we need to book and do your valet.</p>
    <h2>What we collect</h2>
    <p>If you use the booking form, we get the details you type in: your name, phone number, email if you give it, your car, the service you want, your postcode, when suits you, any notes, and any photos you attach. We also record which page you sent it from, and if you arrived from an advert or a link with tracking tags, those tags.</p>
    <h2>What we do with it</h2>
    <p>We use it to give you a price, arrange the valet and get in touch about it, usually on WhatsApp. If you give an email address, we send you one confirmation email. We don't sell or share your details for marketing.</p>
    <h2>Where it's kept</h2>
    <p>Bookings are stored securely with our website host (Netlify) and sent to us by email (through Resend). Photos you attach are stored the same way.</p>
    <h2>Analytics</h2>
    <p>If analytics are switched on, we'll ask before counting your visit with Google Analytics. If you say no, nothing is loaded. There's no advertising tracking on this site.</p>
    <h2>Deleting your details</h2>
    <p>Email <a href={`mailto:${business.email}`}>{business.email}</a> or message {business.phoneDisplay} and we'll delete your booking details.</p>
  </section>
</Base>
<style>
  .pv { width: min(100% - 2 * var(--gutter), 40rem); margin: 2rem auto 5rem; }
  h1 { font-size: clamp(2.4rem, 7vw, 4rem); font-style: italic; margin-bottom: 1.5rem; }
</style>
