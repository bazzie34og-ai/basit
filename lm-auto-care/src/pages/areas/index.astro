---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import Photo from '../../components/Photo.astro';
import Honest from '../../components/Honest.astro';
import FinalCta from '../../components/FinalCta.astro';
import { areaGroups, waMessages } from '../../config/site.ts';
import { meta } from '../../config/pages.ts';
import van from '../../assets/photos/lm-auto-care-van-and-kit-on-site-mg-hs.jpg';
const m = meta('/areas/');
const areas = await getCollection('areas');
const blurb = (slug: string) => areas.find((a) => a.id === slug)?.data.pullQuote ?? '';
---
<Base title={m.title} description={m.description} path="/areas/" waText={waMessages.areas} breadcrumbs={[{ name: 'Areas', href: '/areas/' }]}>
  <section class="top">
    <div class="tx">
      <p class="mono k">Mobile valeting · Aberdeen &amp; Aberdeenshire</p>
      <h1>Where We Valet: Aberdeen and Around</h1>
      <p class="lede">Looking for valeting near you? We're a mobile valeting service, so the van comes to you: the city, the edges of it, and the Aberdeenshire towns round about. Find your bit below. If your street isn't named, send us the postcode. Most of the time the answer's yes.</p>
      <Honest />
    </div>
    <div class="mp"><CoverageMap /></div>
  </section>

  <section class="list">
    {areaGroups.map((g, i) => (
      <article class:list={['grp', { flip: i % 2 }]}>
        <p class="mono no">Area {String(i + 1).padStart(2, '0')} · {g.short}</p>
        <h2><a href={`/areas/${g.slug}/`}>{g.name}</a></h2>
        <p class="sub">{g.suburbs.join(' · ')}</p>
        <p class="why">{blurb(g.slug)}</p>
        <a class="go" href={`/areas/${g.slug}/`}>Mobile valeting in {g.name}</a>
      </article>
    ))}
  </section>

  <section class="mid speckle">
    <div class="mid-in">
      <Photo src={van} alt="Mobile valeting near you: the LM Auto Care van and kit set up on an Aberdeen street" caption="The whole set-up. Fits on a kerb anywhere with a tap and a socket." sizes="(min-width: 900px) 420px, 100vw" />
      <div>
        <h2>Mobile valeting across Aberdeenshire, done the same way everywhere</h2>
        <p>Same prices in Torry as in Westhill. Same size supplement on a 7-seater in Stonehaven as on one in Dyce. Same job sheet, same final check. The only thing that changes is what the car's been through: salt spray on the coast, farm mud out in the shire, dog hair along Deeside, airport dust up north.</p>
        <p>Not on the list? <a href="/book/">Send us your details</a> or a WhatsApp with your postcode.</p>
      </div>
    </div>
  </section>

  <FinalCta waText={waMessages.areas} note={false} heading="Not sure if we cover you? Ask." />
</Base>
<style>
  .top { width: min(100% - 2 * var(--gutter), 1240px); margin: 1.5rem auto 3rem; display: grid; gap: 2rem; }
  @media (min-width: 1000px) { .top { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .k { color: var(--lm-blue-ink); margin: 0 0 1rem; }
  h1 { font-size: clamp(2.4rem, 7vw, 5rem); font-style: italic; line-height: 0.95; letter-spacing: -0.02em; }
  .lede { font-size: 1.18rem; max-width: 36rem; margin: 1.5rem 0 1.2rem; }
  .top :global(.honest-compact) { color: var(--ink-2); }
  .list { width: min(100% - 2 * var(--gutter), 1240px); margin: 0 auto 4rem; display: grid; border-top: 1.5px solid var(--ink); }
  @media (min-width: 860px) { .list { grid-template-columns: 1fr 1fr; } .grp.flip { border-left: 1px solid var(--paper-3); padding-left: 2.5rem; } .grp:not(.flip) { padding-right: 2.5rem; } }
  .grp { padding: 2rem 0; border-bottom: 1px solid var(--paper-3); }
  .no { color: var(--stone-ink); margin: 0 0 0.6rem; }
  .grp h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); font-style: italic; margin-bottom: 0.8rem; }
  .grp h2 a { color: var(--ink); text-decoration: none; }
  .sub { font-family: var(--f-mono); font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-2); }
  .why { font-style: italic; }
  .go { font-size: 0.98rem; }
  .mid { padding: clamp(3.5rem, 8vw, 6rem) 0; }
  .mid-in { width: min(100% - 2 * var(--gutter), 1100px); margin-inline: auto; display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .mid-in { grid-template-columns: 420px 1fr; gap: 4rem; } }
  .mid h2 { font-size: clamp(1.7rem, 3.6vw, 2.4rem); margin-bottom: 1.2rem; }
</style>
