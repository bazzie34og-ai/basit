---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { waLink, waMessages } from '../config/site.ts';
import { meta } from '../config/pages.ts';
const m = meta('/404/');
---
<Base title={m.title} description={m.description} path="/404/" noindex waText={waMessages.notFound}>
  <section class="nf">
    <svg class="sponge" viewBox="0 0 260 200" role="img" aria-label="A sketch of a sad, soapy sponge">
      <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M52 92c-4-18 6-30 26-31 34-2 74-3 108 0 20 2 28 14 26 32l-4 52c-2 16-12 24-30 25-34 2-70 2-102 0-16-1-24-10-25-24z" />
        <path d="M70 110c2 1 3 3 2 5M96 140c2 0 3 2 2 4M168 126c2 1 2 3 1 4M186 102c1 2 1 3-1 4M132 150c2 1 2 2 1 4" opacity=".6" />
        <path d="M104 106c1 3 4 4 6 2M150 106c1 3 4 4 6 2" />
        <path d="M112 134c8-7 22-8 32 0" />
        <path d="M108 116c-1 6-3 9-5 12" class="tear" />
        <circle cx="92" cy="58" r="11" /><circle cx="116" cy="44" r="8" /><circle cx="140" cy="54" r="13" /><circle cx="168" cy="40" r="7" /><circle cx="186" cy="60" r="10" />
        <circle cx="206" cy="30" r="5" /><circle cx="70" cy="40" r="5" />
      </g>
    </svg>
    <p class="mono k">Error 404 · Page not found</p>
    <h1>This page has been washed away.</h1>
    <p class="lede">Whatever was here isn't any more, or the link's got a typo. The sponge is taking it personally.</p>
    <div class="btn-row">
      <a class="btn" href={waLink(waMessages.notFound)} data-track="whatsapp_click" rel="noopener"><Icon name="whatsapp" /> Get a price on WhatsApp</a>
      <a class="btn btn--line" href="/prices/">See the prices</a>
    </div>
    <p class="links">Or try <a href="/">the home page</a>, <a href="/areas/">the areas we cover</a> or <a href="/faq/">the FAQ</a>.</p>
  </section>
</Base>
<style>
  .nf { width: min(100% - 2 * var(--gutter), 720px); margin: 3rem auto 6rem; }
  .sponge { width: 220px; color: var(--ink); margin-bottom: 1.5rem; }
  .sponge .tear { stroke: var(--lm-blue-ink); }
  .k { color: var(--lm-blue-ink); margin: 0 0 1rem; }
  h1 { font-size: clamp(2.2rem, 7vw, 4.2rem); font-style: italic; line-height: 0.98; }
  .lede { font-size: 1.2rem; margin: 1.2rem 0 1.6rem; }
  .links { margin-top: 1.5rem; }
</style>
